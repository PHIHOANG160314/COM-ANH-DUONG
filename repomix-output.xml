<file path="css/pagination.css">
/* ========================================
   F&B MASTER - PAGINATION STYLES
   Premium pagination with WOW effects
   ======================================== */

/* ========================================
   PAGINATION ITEM ANIMATIONS
   ======================================== */
.pagination-item {
    animation: slideInUp 0.4s ease forwards;
    opacity: 0;
}

@keyframes slideInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* ========================================
   EMPTY STATE
   ======================================== */
.pagination-empty {
    text-align: center;
    padding: 40px 20px;
    color: var(--text-muted, #8888a0);
    font-size: 0.95rem;
}

/* ========================================
   SKELETON LOADING
   ======================================== */
.pagination-skeleton {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 8px 0;
}

.skeleton-item {
    height: 80px;
    background: linear-gradient(90deg,
            rgba(255, 255, 255, 0.03) 0%,
            rgba(255, 255, 255, 0.08) 50%,
            rgba(255, 255, 255, 0.03) 100%);
    background-size: 200% 100%;
    border-radius: 12px;
    animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
    0% {
        background-position: -200% 0;
    }

    100% {
        background-position: 200% 0;
    }
}

.pagination-skeleton.fade-out {
    animation: fadeOut 0.2s ease forwards;
}

@keyframes fadeOut {
    to {
        opacity: 0;
        transform: translateY(-10px);
    }
}

/* ========================================
   LOAD MORE BUTTON
   ======================================== */
.pagination-loadmore {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 14px 24px;
    margin-top: 16px;
    background: linear-gradient(135deg,
            rgba(99, 102, 241, 0.15) 0%,
            rgba(16, 185, 129, 0.15) 100%);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 12px;
    color: var(--primary-light, #818cf8);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
}

.pagination-loadmore:hover {
    background: linear-gradient(135deg,
            rgba(99, 102, 241, 0.25) 0%,
            rgba(16, 185, 129, 0.25) 100%);
    border-color: rgba(99, 102, 241, 0.5);
    transform: translateY(-2px);
}

.pagination-loadmore:active {
    transform: scale(0.98);
}

.loadmore-icon {
    display: inline-block;
    animation: bounce 2s infinite;
}

@keyframes bounce {

    0%,
    20%,
    50%,
    80%,
    100% {
        transform: translateY(0);
    }

    40% {
        transform: translateY(4px);
    }

    60% {
        transform: translateY(2px);
    }
}

/* ========================================
   SENTINEL (Infinite Scroll Trigger)
   ======================================== */
.pagination-sentinel {
    height: 1px;
    width: 100%;
    visibility: hidden;
}

/* ========================================
   LOADING SPINNER
   ======================================== */
.pagination-loading {
    display: flex;
    justify-content: center;
    padding: 20px;
}

.pagination-spinner {
    width: 32px;
    height: 32px;
    border: 3px solid rgba(99, 102, 241, 0.2);
    border-top-color: var(--primary, #6366f1);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

/* ========================================
   STATS BAR
   ======================================== */
.pagination-stats {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    margin-bottom: 12px;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 10px;
    font-size: 0.85rem;
    color: var(--text-secondary, #b4b4bc);
}

.pagination-stats-count {
    font-weight: 600;
    color: var(--primary-light, #818cf8);
}

/* ========================================
   ENHANCED COUNTER
   ======================================== */
.pagination-counter {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    margin-top: 12px;
    background: linear-gradient(135deg,
            rgba(99, 102, 241, 0.1) 0%,
            rgba(16, 185, 129, 0.1) 100%);
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: 12px;
    font-size: 0.85rem;
    opacity: 0;
    transform: translateY(-10px);
    transition: all 0.3s ease;
}

.pagination-counter.visible {
    opacity: 1;
    transform: translateY(0);
}

.counter-text {
    color: var(--text-secondary, #b4b4bc);
}

.counter-progress {
    font-weight: 600;
    background: linear-gradient(135deg, var(--primary-light, #818cf8), var(--secondary, #10b981));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}

/* ========================================
   PULL TO REFRESH
   ======================================== */
.pull-indicator {
    position: absolute;
    top: -50px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--bg-card, rgba(26, 26, 46, 0.95));
    border-radius: 50%;
    opacity: 0;
    transition: all 0.3s ease;
}

.pull-indicator.visible {
    opacity: 1;
    top: 10px;
}

.pull-indicator.refreshing .pull-icon {
    animation: spin 0.8s linear infinite;
}

/* ========================================
   RESPONSIVE
   ======================================== */
@media (max-width: 480px) {
    .skeleton-item {
        height: 70px;
    }

    .pagination-loadmore {
        padding: 12px 20px;
        font-size: 0.9rem;
    }
}

/* ========================================
   LIGHT MODE SUPPORT
   ======================================== */
@media (prefers-color-scheme: light) {
    .skeleton-item {
        background: linear-gradient(90deg,
                rgba(0, 0, 0, 0.05) 0%,
                rgba(0, 0, 0, 0.1) 50%,
                rgba(0, 0, 0, 0.05) 100%);
        background-size: 200% 100%;
    }

    .pagination-empty {
        color: #666;
    }
}
