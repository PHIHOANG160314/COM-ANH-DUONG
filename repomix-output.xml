            { label: 'Mang đi', value: channels.takeaway || 0, color: '#f59e0b' }
        ];

        return items.map(item => {
            const percent = Math.round((item.value / total) * 100);
            return `
                <div class="channel-bar-item">
                    <div class="bar-info">
                        <span class="bar-label">${item.label}</span>
