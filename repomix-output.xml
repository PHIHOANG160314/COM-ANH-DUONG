<file path="css/m3-wow-effects.css">
/* =====================================================
   MATERIAL DESIGN 3 - WOW EFFECTS
   Aurora Gradients, Glassmorphism, Premium Animations
   Ánh Dương F&B - Premium Experience
   ===================================================== */

/* =====================================================
   AURORA GRADIENT BACKGROUNDS
   Flowing, animated color backgrounds
   ===================================================== */

@keyframes aurora {
    0% {
        background-position: 0% 50%;
    }

    25% {
        background-position: 50% 100%;
    }

    50% {
        background-position: 100% 50%;
    }

    75% {
        background-position: 50% 0%;
    }

    100% {
        background-position: 0% 50%;
    }
}

@keyframes aurora-pulse {

    0%,
    100% {
        opacity: 0.8;
        filter: blur(60px);
    }

    50% {
        opacity: 1;
        filter: blur(80px);
    }
}

/* Main Aurora Background */
.aurora-bg {
    position: relative;
    background: linear-gradient(-45deg,
            #002200,
            #003300,
            #004400,
            #1a3a1a,
            #004d00,
            #003300);
    background-size: 400% 400%;
    animation: aurora 20s ease infinite;
}

/* Aurora Overlay Effect */
.aurora-bg::before {
    content: '';
    position: fixed;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background:
        radial-gradient(ellipse at 20% 30%, rgba(115, 194, 73, 0.15) 0%, transparent 50%),
        radial-gradient(ellipse at 80% 20%, rgba(0, 100, 0, 0.2) 0%, transparent 40%),
        radial-gradient(ellipse at 60% 80%, rgba(255, 179, 0, 0.1) 0%, transparent 40%),
        radial-gradient(ellipse at 10% 70%, rgba(46, 125, 50, 0.15) 0%, transparent 50%);
    animation: aurora-pulse 8s ease-in-out infinite;
    pointer-events: none;
    z-index: 0;
}

/* Light Aurora for Headers */
.aurora-header {
    background: linear-gradient(135deg,
            var(--md-sys-color-primary) 0%,
            var(--md-sys-color-secondary) 50%,
            var(--md-sys-color-primary) 100%);
    background-size: 200% 200%;
    animation: aurora 8s ease infinite;
}

/* =====================================================
   GLASSMORPHISM EFFECTS
   Frosted glass with backdrop blur
   ===================================================== */

.glass {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.glass-card {
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--md-sys-shape-corner-large, 16px);
    box-shadow:
        0 8px 32px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.glass-card:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-4px);
    box-shadow:
        0 16px 48px rgba(0, 0, 0, 0.4),
        inset 0 1px 0 rgba(255, 255, 255, 0.15);
}

.glass-nav {
    background: rgba(0, 50, 0, 0.6);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-right: 1px solid rgba(255, 255, 255, 0.08);
}

.glass-header {
    background: rgba(0, 50, 0, 0.5);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.glass-modal {
    background: rgba(30, 40, 30, 0.85);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--md-sys-shape-corner-extra-large, 28px);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5);
}

/* =====================================================
   GLOW EFFECTS
   Vibrant glow on hover and focus
   ===================================================== */

.glow-primary {
    box-shadow: 0 0 20px rgba(0, 100, 0, 0.4);
}

.glow-secondary {
    box-shadow: 0 0 20px rgba(115, 194, 73, 0.4);
}

.glow-tertiary {
    box-shadow: 0 0 20px rgba(255, 179, 0, 0.4);
}

.glow-hover:hover {
    box-shadow:
        0 4px 20px rgba(0, 100, 0, 0.4),
        0 0 40px rgba(115, 194, 73, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.1);
}

.glow-active {
    box-shadow:
        0 0 0 2px rgba(115, 194, 73, 0.3),
        0 0 20px rgba(115, 194, 73, 0.3),
        0 4px 16px rgba(0, 0, 0, 0.3);
}

/* Button Glow */
.btn-glow {
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
}

.btn-glow::before {
    content: '';
    position: absolute;
    inset: -2px;
    background: linear-gradient(45deg,
            var(--md-sys-color-primary),
            var(--md-sys-color-secondary),
            var(--ad-color-tertiary),
            var(--md-sys-color-primary));
    background-size: 400%;
    filter: blur(8px);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: -1;
    animation: aurora 4s linear infinite;
}

.btn-glow:hover::before {
    opacity: 0.6;
}

/* =====================================================
   MICRO-INTERACTIONS & ANIMATIONS
   Delightful feedback animations
   ===================================================== */

/* Float Animation */
@keyframes float {

    0%,
    100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-8px);
    }
}

.float {
    animation: float 3s ease-in-out infinite;
}

/* Pulse Animation */
@keyframes pulse {

    0%,
    100% {
        transform: scale(1);
        opacity: 1;
    }

    50% {
        transform: scale(1.05);
        opacity: 0.9;
    }
}

.pulse {
    animation: pulse 2s ease-in-out infinite;
}

/* Shimmer Effect */
@keyframes shimmer {
    0% {
        background-position: -200% 0;
    }

    100% {
        background-position: 200% 0;
    }
}

.shimmer {
    background: linear-gradient(90deg,
            rgba(255, 255, 255, 0) 0%,
            rgba(255, 255, 255, 0.1) 50%,
            rgba(255, 255, 255, 0) 100%);
    background-size: 200% 100%;
    animation: shimmer 2s linear infinite;
}

/* Glow Pulse */
@keyframes glow-pulse {

    0%,
    100% {
        box-shadow: 0 0 10px rgba(115, 194, 73, 0.3);
    }

    50% {
        box-shadow: 0 0 25px rgba(115, 194, 73, 0.5);
    }
}

.glow-pulse {
    animation: glow-pulse 2s ease-in-out infinite;
}

/* Icon Bounce */
@keyframes icon-bounce {

    0%,
    100% {
        transform: translateY(0);
    }

    25% {
        transform: translateY(-4px);
    }

    50% {
        transform: translateY(0);
    }

    75% {
        transform: translateY(-2px);
    }
}

.icon-bounce:hover {
    animation: icon-bounce 0.5s ease;
}

/* Card Lift */
.card-lift {
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
        box-shadow 0.3s ease;
}

.card-lift:hover {
    transform: translateY(-8px) scale(1.02);
}

/* Ripple Effect */
.ripple {
    position: relative;
    overflow: hidden;
}

.ripple::after {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    pointer-events: none;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.3) 10%, transparent 10.01%);
    background-repeat: no-repeat;
    background-position: 50%;
    transform: scale(10, 10);
    opacity: 0;
    transition: transform 0.4s, opacity 0.8s;
}

.ripple:active::after {
    transform: scale(0, 0);
    opacity: 0.3;
    transition: 0s;
}

/* Page Transition */
@keyframes page-enter {
    from {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.page-enter {
    animation: page-enter 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

/* Slide In */
@keyframes slide-in-right {
    from {
        opacity: 0;
        transform: translateX(30px);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }
}

.slide-in-right {
    animation: slide-in-right 0.4s ease-out forwards;
}

/* Scale In */
@keyframes scale-in {
    from {
        opacity: 0;
        transform: scale(0.9);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }
}

.scale-in {
    animation: scale-in 0.3s ease-out forwards;
}

/* =====================================================
   GRADIENT TEXT
   Beautiful gradient text effects
   ===================================================== */

.text-gradient {
    background: linear-gradient(135deg,
            var(--md-sys-color-primary) 0%,
            var(--md-sys-color-secondary) 50%,
            var(--ad-color-tertiary) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}

.text-gradient-gold {
    background: linear-gradient(135deg,
            #FFD700 0%,
            #FFA000 50%,
            #FF8C00 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}

.text-gradient-green {
    background: linear-gradient(135deg,
            #4CAF50 0%,
            #73C249 50%,
            #8BC34A 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}

/* =====================================================
   STATUS GLOW EFFECTS
   For kitchen/order status indicators
   ===================================================== */

.status-pending {
    border-left: 4px solid #FFC107;
    box-shadow: -2px 0 20px rgba(255, 193, 7, 0.3);
}

.status-preparing {
    border-left: 4px solid #2196F3;
    box-shadow: -2px 0 20px rgba(33, 150, 243, 0.3);
    animation: glow-pulse 2s ease-in-out infinite;
}

.status-ready {
    border-left: 4px solid #4CAF50;
    box-shadow: -2px 0 20px rgba(76, 175, 80, 0.4);
}

.status-urgent {
    border-left: 4px solid #F44336;
    box-shadow: -2px 0 20px rgba(244, 67, 54, 0.4);
    animation: pulse 1s ease-in-out infinite;
}

/* =====================================================
   PREMIUM BUTTON STYLES
   Enhanced M3 buttons with glow
   ===================================================== */

.btn-premium {
    background: linear-gradient(135deg,
            var(--md-sys-color-primary) 0%,
            var(--md-sys-color-secondary) 100%);
    color: white;
    border: none;
    border-radius: var(--md-sys-shape-corner-full, 9999px);
    padding: 12px 32px;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
}

.btn-premium::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg,
            transparent,
            rgba(255, 255, 255, 0.2),
            transparent);
    transition: left 0.5s;
}

.btn-premium:hover {
    transform: translateY(-2px);
    box-shadow:
        0 8px 25px rgba(0, 100, 0, 0.4),
        0 0 40px rgba(115, 194, 73, 0.3);
}

.btn-premium:hover::before {
    left: 100%;
}

.btn-premium:active {
    transform: translateY(0);
}

/* =====================================================
   NAVIGATION GLOW INDICATOR
   Active nav with glow effect
   ===================================================== */

.nav-glow-indicator {
    position: relative;
}

.nav-glow-indicator::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 0;
    background: linear-gradient(180deg,
            var(--md-sys-color-primary),
            var(--md-sys-color-secondary));
    border-radius: 0 4px 4px 0;
    transition: height 0.3s ease;
    box-shadow: 0 0 10px var(--md-sys-color-primary);
}

.nav-glow-indicator.active::after {
    height: 70%;
}

/* =====================================================
   LOADING STATES
   Premium loading animations
   ===================================================== */

.skeleton {
    background: linear-gradient(90deg,
            rgba(255, 255, 255, 0.05) 0%,
            rgba(255, 255, 255, 0.1) 50%,
            rgba(255, 255, 255, 0.05) 100%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
    border-radius: var(--md-sys-shape-corner-small, 8px);
}

/* Spinner with glow */
@keyframes spin-glow {
    0% {
        transform: rotate(0deg);
        box-shadow: 0 0 10px var(--md-sys-color-primary);
    }

    50% {
        box-shadow: 0 0 20px var(--md-sys-color-secondary);
    }

    100% {
        transform: rotate(360deg);
        box-shadow: 0 0 10px var(--md-sys-color-primary);
    }
}

.spinner-glow {
    width: 40px;
    height: 40px;
    border: 3px solid rgba(255, 255, 255, 0.1);
    border-top-color: var(--md-sys-color-primary);
    border-radius: 50%;
    animation: spin-glow 1s linear infinite;
}

/* =====================================================
   RESPONSIVE ADJUSTMENTS
   Reduce effects on mobile for performance
   ===================================================== */

@media (max-width: 768px) {
    .aurora-bg::before {
        animation: none;
        opacity: 0.5;
    }

    .glass-card:hover {
        transform: none;
    }

    .card-lift:hover {
        transform: translateY(-4px);
    }
}

/* Reduce motion for accessibility */
@media (prefers-reduced-motion: reduce) {

    .aurora-bg,
    .aurora-bg::before,
    .float,
    .pulse,
    .shimmer,
    .glow-pulse {
        animation: none;
    }

    .card-lift:hover,
    .glass-card:hover {
        transform: none;
    }
}

/* =====================================================
   ENHANCED KPI CARDS - PREMIUM WOW
   ===================================================== */

.kpi-card {
    position: relative;
    overflow: hidden;
    background: linear-gradient(145deg,
            rgba(30, 50, 35, 0.8) 0%,
            rgba(20, 40, 25, 0.9) 100%) !important;
    border: 1px solid rgba(115, 194, 73, 0.2) !important;
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) !important;
}

.kpi-card::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: conic-gradient(from 180deg at 50% 50%,
            transparent 0deg,
            rgba(115, 194, 73, 0.15) 60deg,
            transparent 120deg);
    animation: rotate-gradient 4s linear infinite;
    opacity: 0;
    transition: opacity 0.5s;
    z-index: 0;
}

.kpi-card:hover::before {
    opacity: 1;
}

.kpi-card:hover {
    transform: translateY(-12px) scale(1.03) !important;
    border-color: var(--md-sys-color-primary) !important;
    box-shadow:
        0 20px 60px rgba(0, 100, 0, 0.4),
        0 0 60px rgba(115, 194, 73, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.15) !important;
}

@keyframes rotate-gradient {
    from {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }
}

/* KPI Icon Premium Effects */
.kpi-icon {
    position: relative;
    z-index: 1;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
}

.kpi-card:hover .kpi-icon {
    transform: scale(1.15) rotate(5deg);
}

/* Revenue Card Special */
.kpi-card.revenue {
    border-left: 3px solid #10b981 !important;
}

.kpi-card.revenue:hover {
    background: linear-gradient(145deg,
            rgba(16, 185, 129, 0.2) 0%,
            rgba(20, 40, 25, 0.95) 100%) !important;
}

/* Orders Card Special */
.kpi-card.orders {
    border-left: 3px solid #6366f1 !important;
}

.kpi-card.orders:hover {
    background: linear-gradient(145deg,
            rgba(99, 102, 241, 0.2) 0%,
            rgba(20, 40, 25, 0.95) 100%) !important;
}

/* FoodCost Card Special */
.kpi-card.foodcost {
    border-left: 3px solid #f59e0b !important;
}

.kpi-card.foodcost:hover {
    background: linear-gradient(145deg,
            rgba(245, 158, 11, 0.2) 0%,
            rgba(20, 40, 25, 0.95) 100%) !important;
}

/* Inventory Card Special */
.kpi-card.inventory {
    border-left: 3px solid #ef4444 !important;
}

.kpi-card.inventory:hover {
    background: linear-gradient(145deg,
            rgba(239, 68, 68, 0.2) 0%,
            rgba(20, 40, 25, 0.95) 100%) !important;
}

/* =====================================================
   PREMIUM SIDEBAR - GLASS MORPHISM
   ===================================================== */

.sidebar {
    background: linear-gradient(180deg,
            rgba(0, 60, 0, 0.9) 0%,
            rgba(0, 40, 0, 0.98) 100%) !important;
    box-shadow:
        4px 0 30px rgba(0, 0, 0, 0.4),
        inset -1px 0 0 rgba(255, 255, 255, 0.05) !important;
}

/* Logo Premium Effect */
.logo-text {
    background: linear-gradient(135deg,
            #73C249 0%,
            #98DF6A 25%,
            #FFB300 50%,
            #98DF6A 75%,
            #73C249 100%) !important;
    background-size: 400% 400% !important;
    -webkit-background-clip: text !important;
    background-clip: text !important;
    animation: gradient-flow 5s ease infinite !important;
}

@keyframes gradient-flow {
    0% {
        background-position: 0% 50%;
    }

    50% {
        background-position: 100% 50%;
    }

    100% {
        background-position: 0% 50%;
    }
}

/* Nav Items Premium */
.nav-item.active {
    background: linear-gradient(90deg,
            rgba(0, 100, 0, 0.6) 0%,
            rgba(115, 194, 73, 0.2) 100%) !important;
    border-left: 4px solid #73C249 !important;
    box-shadow:
        0 0 20px rgba(115, 194, 73, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.05) !important;
}

/* =====================================================
   STAGGERED ANIMATIONS
   ===================================================== */

.kpi-grid>.kpi-card:nth-child(1) {
    animation-delay: 0.05s;
}

.kpi-grid>.kpi-card:nth-child(2) {
    animation-delay: 0.1s;
}

.kpi-grid>.kpi-card:nth-child(3) {
    animation-delay: 0.15s;
}

.kpi-grid>.kpi-card:nth-child(4) {
    animation-delay: 0.2s;
}

.kpi-grid>.kpi-card {
    animation: slide-up-wow 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) backwards;
}

@keyframes slide-up-wow {
    from {
        opacity: 0;
        transform: translateY(40px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* =====================================================
   PREMIUM BUTTONS
   ===================================================== */

.btn-primary {
    position: relative;
    background: linear-gradient(135deg,
            var(--md-sys-color-primary) 0%,
            #2E7D32 50%,
            var(--md-sys-color-primary) 100%) !important;
    background-size: 200% 200% !important;
    box-shadow: 0 4px 15px rgba(0, 100, 0, 0.4) !important;
}

.btn-primary:hover {
    background-position: 100% 0 !important;
    transform: translateY(-4px) scale(1.02) !important;
    box-shadow:
        0 8px 25px rgba(0, 100, 0, 0.5),
        0 0 40px rgba(115, 194, 73, 0.3) !important;
}

/* =====================================================
   TREND BADGES PREMIUM
   ===================================================== */

.kpi-trend {
    position: relative;
    overflow: hidden;
}

.kpi-trend::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg,
            transparent 0%,
            rgba(255, 255, 255, 0.3) 50%,
            transparent 100%);
    animation: trend-shine 2s linear infinite;
}

@keyframes trend-shine {
    from {
        left: -100%;
    }

    to {
        left: 100%;
    }
}

/* =====================================================
   TABLE PREMIUM EFFECTS
   ===================================================== */

.data-table tbody tr:hover {
    background: linear-gradient(90deg,
            rgba(115, 194, 73, 0.1) 0%,
            transparent 50%,
            rgba(115, 194, 73, 0.1) 100%) !important;
    transform: scale(1.01);
}

/* =====================================================
   CHART CARD PREMIUM
   ===================================================== */

.chart-card::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(90deg,
            transparent 0%,
            rgba(255, 255, 255, 0.03) 50%,
            transparent 100%);
    animation: chart-shine 4s ease-in-out infinite;
    pointer-events: none;
}

@keyframes chart-shine {

    0%,
    100% {
        left: -100%;
    }

    50% {
        left: 150%;
    }
}
</file>

<file path="css/menu-categories.css">
/* ========================================
   F&B MASTER - MENU CATEGORIES CSS
   Swipeable Subcategory Tabs
   ======================================== */

/* Subcategory Tabs Container */
.subcategory-tabs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 8px 0;
    margin: 8px 0 16px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
}

.subcategory-tabs::-webkit-scrollbar {
    display: none;
}

/* Subcategory Tab Button */
.subcategory-tab {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    border-radius: 25px;
    border: 1px solid var(--border-color, rgba(255, 255, 255, 0.1));
    background: var(--bg-card, rgba(26, 26, 46, 0.95));
    color: var(--text-secondary, #b4b4bc);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
}

.subcategory-tab .tab-icon {
    font-size: 1rem;
}

.subcategory-tab .tab-count {
    background: rgba(255, 255, 255, 0.1);
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 0.7rem;
}

/* Active State */
.subcategory-tab.active {
    background: linear-gradient(135deg, var(--primary, #6366f1), var(--secondary, #10b981));
    border-color: transparent;
    color: white;
}

.subcategory-tab.active .tab-count {
    background: rgba(255, 255, 255, 0.25);
}

/* Hover Effect */
.subcategory-tab:hover:not(.active) {
    background: rgba(99, 102, 241, 0.1);
    border-color: var(--primary, #6366f1);
}

/* ========================================
   FEATURED SECTION
   ======================================== */
.featured-section {
    margin-bottom: 24px;
}

.featured-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.featured-title {
    font-size: 1.1rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
}

.featured-title .fire-icon {
    animation: pulse 1.5s ease infinite;
}

@keyframes pulse {

    0%,
    100% {
        transform: scale(1);
    }

    50% {
        transform: scale(1.2);
    }
}

/* Featured Cards - Horizontal Scroll */
.featured-cards {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding: 4px 0;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
}

.featured-cards::-webkit-scrollbar {
    display: none;
}

.featured-card {
    flex-shrink: 0;
    width: 160px;
    background: linear-gradient(145deg, rgba(99, 102, 241, 0.15), rgba(16, 185, 129, 0.15));
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 16px;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.3s ease;
}

.featured-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(99, 102, 241, 0.3);
}

.featured-card-image {
    width: 100%;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3.5rem;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.2), rgba(16, 185, 129, 0.2));
}

.featured-card-body {
    padding: 12px;
}

.featured-card-name {
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 4px;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.featured-card-price {
    font-size: 1rem;
    font-weight: 700;
    color: var(--secondary, #10b981);
}

.featured-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    background: linear-gradient(135deg, #ef4444, #dc2626);
    color: white;
    font-size: 0.65rem;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 8px;
}

/* ========================================
   MENU SECTION HEADER
   ======================================== */
.menu-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
}

.menu-section-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary, #f8f8fa);
}

.menu-item-count {
    font-size: 0.8rem;
    color: var(--text-muted, #8888a0);
}

/* ========================================
   RESPONSIVE ADJUSTMENTS
   ======================================== */
@media (max-width: 375px) {
    .subcategory-tab {
        padding: 8px 12px;
        font-size: 0.8rem;
    }

    .featured-card {
        width: 140px;
    }

    .featured-card-image {
        height: 80px;
        font-size: 2.5rem;
    }
}
