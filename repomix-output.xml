    getComboDetails(comboId, menuItems) {
        const combo = this.combos.find(c => c.id === comboId);
        if (!combo) return null;

        const items = combo.items.map(itemId =>
            menuItems.find(m => m.id === itemId)
        ).filter(Boolean);

        return {
            ...combo,
            itemDetails: items
        };
    }
