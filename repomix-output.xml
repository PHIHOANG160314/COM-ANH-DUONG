<file path="css/staff-mobile.css">
/* ========================================
   F&B MASTER - STAFF MOBILE CSS
   Mobile-First Staff Portal
   Material Design 3 Integration
   ======================================== */

/* Import M3 Design System */
@import url('./m3-design-system.css');

:root {
    /* M3 Color Tokens - Override with M3 System */
    --primary: var(--md-sys-color-primary);
    --primary-dark: var(--ad-color-primary, #004D00);
    --primary-light: var(--md-sys-color-secondary);
    --secondary: var(--md-sys-color-tertiary);
    --warning: var(--ad-color-warning, #f59e0b);
    --danger: var(--md-sys-color-error);

    /* M3 Surface Colors */
    --bg-dark: var(--md-sys-color-background);
    --bg-card: var(--md-sys-color-surface-container);
    --text-primary: var(--md-sys-color-on-background);
    --text-secondary: var(--md-sys-color-on-surface-variant);
    --text-muted: var(--md-sys-color-outline);
    --border-color: var(--md-sys-color-outline-variant);

    /* M3 Elevation */
    --shadow: var(--md-sys-elevation-level2);

    /* M3 Shape */
    --radius: var(--md-sys-shape-corner-large);
    --radius-sm: var(--md-sys-shape-corner-medium);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--md-sys-typescale-body-large-font, 'Roboto', -apple-system, sans-serif);
    background: var(--md-sys-color-background);
    color: var(--md-sys-color-on-background);
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
}

/* M3 Dark Theme Support */
@media (prefers-color-scheme: dark) {
    body {
        background: var(--md-sys-color-surface);
    }
}

/* ========================================
   HEADER - M3 Top App Bar
   ======================================== */
.staff-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--md-sys-color-surface-container);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
    box-shadow: var(--md-sys-elevation-level1);
}

.header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    min-height: 64px;
}

.header-left {
    display: flex;
    align-items: center;
    gap: 12px;
}

.logo-img {
    width: 40px;
    height: 40px;
    border-radius: var(--md-sys-shape-corner-medium);
    object-fit: cover;
}

.header-title h1 {
    font-size: var(--md-sys-typescale-title-medium-size);
    font-weight: var(--md-sys-typescale-title-medium-weight);
    color: var(--md-sys-color-primary);
}

.header-title p {
    font-size: var(--md-sys-typescale-label-small-size);
    color: var(--md-sys-color-on-surface-variant);
}

.staff-info {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    background: var(--md-sys-color-surface-container-high);
    border-radius: var(--md-sys-shape-corner-full);
    border: 1px solid var(--md-sys-color-outline-variant);
}

.staff-avatar {
    font-size: 1.2rem;
}

.staff-name {
    font-size: var(--md-sys-typescale-label-large-size);
    font-weight: var(--md-sys-typescale-label-large-weight);
    color: var(--md-sys-color-on-surface);
}

/* Role Badge - M3 Badge Style */
.role-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    margin-left: 8px;
    background: var(--ad-gradient-primary);
    border-radius: var(--md-sys-shape-corner-full);
    font-size: var(--md-sys-typescale-label-small-size);
    font-weight: 600;
    color: var(--md-sys-color-on-primary);
}

/* Disabled/Hidden action cards */
.action-card.disabled,
.action-card[style*="display: none"]+.action-card {
    opacity: 0.5;
    pointer-events: none;
}

.nav-item.disabled {
    opacity: 0.4;
    pointer-events: none;
}

/* ========================================
   MAIN CONTENT
   ======================================== */
.staff-main {
    padding: 16px;
    padding-bottom: 100px;
}

.section {
    display: none;
    animation: fadeIn var(--md-sys-motion-duration-medium2) var(--md-sys-motion-easing-emphasized-decelerate);
}

.section.active {
    display: block;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* ========================================
   LOGIN - M3 Card Style
   ======================================== */
.login-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 70vh;
}

.login-card {
    background: var(--md-sys-color-surface-container-low);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-extra-large);
    padding: 32px;
    text-align: center;
    width: 100%;
    max-width: 320px;
    box-shadow: var(--md-sys-elevation-level2);
}

.login-icon {
    font-size: 4rem;
    margin-bottom: 16px;
}

.login-card h2 {
    font-size: var(--md-sys-typescale-headline-small-size);
    font-weight: var(--md-sys-typescale-headline-small-weight);
    color: var(--md-sys-color-on-surface);
    margin-bottom: 8px;
}

.login-card p {
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-body-medium-size);
    margin-bottom: 24px;
}

.pin-input-group {
    margin-bottom: 20px;
}

.pin-input {
    width: 100%;
    padding: 16px;
    font-size: 2rem;
    text-align: center;
    letter-spacing: 1rem;
    border: 2px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-corner-medium);
    background: var(--md-sys-color-surface-container-highest);
    color: var(--md-sys-color-on-surface);
    transition: all var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
}

.pin-input:focus {
    outline: none;
    border-color: var(--md-sys-color-primary);
    box-shadow: 0 0 0 2px var(--md-sys-color-primary-container);
}

/* M3 Filled Button */
.btn-login {
    width: 100%;
    padding: 16px;
    border: none;
    border-radius: var(--md-sys-shape-corner-full);
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
    font-size: var(--md-sys-typescale-label-large-size);
    font-weight: var(--md-sys-typescale-label-large-weight);
    cursor: pointer;
    transition: all var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-emphasized);
}

.btn-login:hover {
    box-shadow: var(--md-sys-elevation-level2);
}

.btn-login:active {
    transform: scale(0.98);
}

.login-help {
    margin-top: 16px;
    font-size: var(--md-sys-typescale-body-small-size);
    color: var(--md-sys-color-on-surface-variant);
}

/* ========================================
   DASHBOARD - M3 Cards
   ======================================== */
.dashboard-container {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.quick-actions {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
}

/* M3 Filled Card Style for Actions */
.action-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 20px 16px;
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    color: var(--md-sys-color-on-surface);
    cursor: pointer;
    transition: all var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-emphasized);
    box-shadow: var(--md-sys-elevation-level1);
}

.action-card:hover {
    box-shadow: var(--md-sys-elevation-level2);
}

.action-card:active {
    transform: scale(0.98);
}

.action-card.checkin {
    background: var(--md-sys-color-secondary-container);
    border-color: transparent;
}

.action-card.checkin .action-icon,
.action-card.checkin .action-label {
    color: var(--md-sys-color-on-secondary-container);
}

.action-card.checkin.checked-in {
    background: var(--md-sys-color-error-container);
    border-color: transparent;
}

.action-card.checkin.checked-in .action-icon,
.action-card.checkin.checked-in .action-label {
    color: var(--md-sys-color-on-error-container);
}

.action-card.kitchen {
    background: var(--md-sys-color-tertiary-container);
    border-color: transparent;
}

.action-card.kitchen .action-icon,
.action-card.kitchen .action-label {
    color: var(--md-sys-color-on-tertiary-container);
}

.action-card.pos {
    background: var(--md-sys-color-primary-container);
    border-color: transparent;
}

.action-card.pos .action-icon,
.action-card.pos .action-label {
    color: var(--md-sys-color-on-primary-container);
}

.action-card.orders {
    background: var(--md-sys-color-secondary-container);
    border-color: transparent;
}

.action-card.orders .action-icon,
.action-card.orders .action-label {
    color: var(--md-sys-color-on-secondary-container);
}

.action-icon {
    font-size: 2rem;
}

.action-label {
    font-weight: var(--md-sys-typescale-label-large-weight);
    font-size: var(--md-sys-typescale-label-large-size);
}

.action-time {
    font-size: var(--md-sys-typescale-label-small-size);
    color: var(--md-sys-color-on-surface-variant);
}

/* M3 Badge */
.action-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background: var(--md-sys-color-error);
    color: var(--md-sys-color-on-error);
    font-size: var(--md-sys-typescale-label-small-size);
    font-weight: 600;
    padding: 2px 8px;
    border-radius: var(--md-sys-shape-corner-full);
    min-width: 20px;
    text-align: center;
}

/* Summary Card - M3 Outlined Card */
.summary-card {
    background: var(--md-sys-color-surface-container-low);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    padding: 20px;
}

.summary-card h3 {
    margin-bottom: 16px;
    font-size: var(--md-sys-typescale-title-medium-size);
    font-weight: var(--md-sys-typescale-title-medium-weight);
    color: var(--md-sys-color-on-surface);
}

.summary-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    text-align: center;
}

.summary-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.summary-value {
    font-size: var(--md-sys-typescale-headline-small-size);
    font-weight: 700;
    color: var(--md-sys-color-primary);
}

.summary-label {
    font-size: var(--md-sys-typescale-label-small-size);
    color: var(--md-sys-color-on-surface-variant);
}

/* Recent Orders - M3 Card */
.recent-orders {
    background: var(--md-sys-color-surface-container-low);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    padding: 20px;
}

.recent-orders h3 {
    margin-bottom: 16px;
    font-size: var(--md-sys-typescale-title-medium-size);
    font-weight: var(--md-sys-typescale-title-medium-weight);
}

.orders-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

/* ========================================
   KITCHEN - M3 Cards
   ======================================== */
.kitchen-container,
.orders-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.section-header {
    display: flex;
    align-items: center;
    gap: 12px;
}

/* M3 Text Button */
.btn-back {
    padding: 8px 16px;
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-corner-full);
    color: var(--md-sys-color-on-surface);
    font-size: var(--md-sys-typescale-label-large-size);
    cursor: pointer;
    transition: all var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
}

.btn-back:hover {
    background: var(--md-sys-color-surface-container-high);
}

.section-header h2 {
    font-size: var(--md-sys-typescale-title-large-size);
    font-weight: var(--md-sys-typescale-title-large-weight);
}

.kitchen-orders {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.kitchen-order-card {
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    padding: 16px;
    box-shadow: var(--md-sys-elevation-level1);
    transition: all var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
}

.kitchen-order-card.urgent {
    border-color: var(--md-sys-color-error);
    background: var(--md-sys-color-error-container);
    animation: pulse-border 2s infinite;
}

@keyframes pulse-border {

    0%,
    100% {
        box-shadow: 0 0 0 0 rgba(186, 26, 26, 0.4);
    }

    50% {
        box-shadow: 0 0 0 8px rgba(186, 26, 26, 0);
    }
}

.kitchen-order-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.kitchen-order-id {
    font-weight: var(--md-sys-typescale-title-medium-weight);
    font-size: var(--md-sys-typescale-title-medium-size);
}

.kitchen-order-time {
    font-size: var(--md-sys-typescale-label-medium-size);
    color: var(--ad-color-warning);
}

.kitchen-order-items {
    margin-bottom: 12px;
    font-size: var(--md-sys-typescale-body-medium-size);
}

.kitchen-order-item {
    padding: 6px 0;
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
}

.kitchen-order-item:last-child {
    border-bottom: none;
}

.kitchen-order-actions {
    display: flex;
    gap: 8px;
}

/* M3 Filled Tonal Button */
.btn-kitchen {
    flex: 1;
    padding: 12px;
    border: none;
    border-radius: var(--md-sys-shape-corner-full);
    font-weight: var(--md-sys-typescale-label-large-weight);
    font-size: var(--md-sys-typescale-label-large-size);
    cursor: pointer;
    transition: all var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-emphasized);
}

.btn-kitchen.start {
    background: var(--md-sys-color-tertiary-container);
    color: var(--md-sys-color-on-tertiary-container);
}

.btn-kitchen.start:hover {
    box-shadow: var(--md-sys-elevation-level1);
}

.btn-kitchen.complete {
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
}

.btn-kitchen.complete:hover {
    box-shadow: var(--md-sys-elevation-level2);
}

.btn-kitchen:active {
    transform: scale(0.98);
}

/* ========================================
   ORDERS - M3 Filter Chips
   ======================================== */
.order-filters {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 4px 0;
}

/* M3 Filter Chip */
.filter-btn {
    flex-shrink: 0;
    padding: 10px 18px;
    border: 1px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-corner-small);
    background: var(--md-sys-color-surface);
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-label-large-size);
    font-weight: var(--md-sys-typescale-label-large-weight);
    cursor: pointer;
    transition: all var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
}

.filter-btn.active {
    background: var(--md-sys-color-secondary-container);
    border-color: transparent;
    color: var(--md-sys-color-on-secondary-container);
}

.filter-btn:hover:not(.active) {
    background: var(--md-sys-color-surface-container);
}

/* Order Card - M3 Outlined Card */
.order-card {
    background: var(--md-sys-color-surface-container-low);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    padding: 16px;
    box-shadow: var(--md-sys-elevation-level1);
}

.order-card-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
}

.order-card-id {
    font-weight: var(--md-sys-typescale-title-medium-weight);
}

/* M3 Status Chips */
.order-card-status {
    padding: 4px 12px;
    border-radius: var(--md-sys-shape-corner-full);
    font-size: var(--md-sys-typescale-label-small-size);
    font-weight: var(--md-sys-typescale-label-large-weight);
}

.order-card-status.pending {
    background: var(--ad-status-pending-bg);
    color: var(--ad-status-pending);
}

.order-card-status.preparing {
    background: var(--ad-status-preparing-bg);
    color: var(--ad-status-preparing);
}

.order-card-status.completed {
    background: var(--ad-status-completed-bg);
    color: var(--ad-status-completed);
}

.order-card-info {
    font-size: var(--md-sys-typescale-body-medium-size);
    color: var(--md-sys-color-on-surface-variant);
}

.order-card-total {
    margin-top: 12px;
    font-weight: var(--md-sys-typescale-title-medium-weight);
    color: var(--md-sys-color-primary);
}

/* ========================================
   BOTTOM NAVIGATION - M3 Navigation Bar
   ======================================== */
.bottom-nav {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 80px;
    background: var(--md-sys-color-surface-container);
    border-top: 1px solid var(--md-sys-color-outline-variant);
    padding: 0 16px;
    padding-bottom: env(safe-area-inset-bottom);
    z-index: 1000;
}

.bottom-nav.show {
    display: flex;
    justify-content: space-around;
    align-items: center;
}

/* M3 Navigation Bar Item */
.nav-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 12px 16px;
    background: transparent;
    border: none;
    color: var(--md-sys-color-on-surface-variant);
    cursor: pointer;
    transition: all var(--md-sys-motion-duration-short2) var(--md-sys-motion-easing-standard);
}

.nav-item .nav-icon {
    width: 64px;
    height: 32px;
    border-radius: var(--md-sys-shape-corner-full);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    transition: all var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-emphasized);
}

.nav-item.active {
    color: var(--md-sys-color-on-surface);
}

.nav-item.active .nav-icon {
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
}

.nav-label {
    font-size: var(--md-sys-typescale-label-medium-size);
    font-weight: var(--md-sys-typescale-label-medium-weight);
}

/* ========================================
   TOAST - M3 Snackbar
   ======================================== */
.toast-container {
    position: fixed;
    top: 80px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 400;
}

.toast {
    padding: 14px 20px;
    margin-bottom: 8px;
    border-radius: var(--md-sys-shape-corner-extra-small);
    background: var(--md-sys-color-inverse-surface);
    color: var(--md-sys-color-inverse-on-surface);
    font-size: var(--md-sys-typescale-body-medium-size);
    font-weight: var(--md-sys-typescale-label-large-weight);
    animation: toastIn var(--md-sys-motion-duration-medium2) var(--md-sys-motion-easing-emphasized-decelerate);
    box-shadow: var(--md-sys-elevation-level3);
}

.toast.error {
    background: var(--md-sys-color-error);
    color: var(--md-sys-color-on-error);
}

.toast.success {
    background: var(--ad-color-success);
    color: var(--ad-color-on-success);
}

@keyframes toastIn {
    from {
        opacity: 0;
        transform: translateY(-20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.no-orders {
    text-align: center;
    color: var(--md-sys-color-on-surface-variant);
    padding: 24px;
    font-size: var(--md-sys-typescale-body-large-size);
}

/* ========================================
   CUSTOM INPUT STYLES (Fix for MD Web issues)
   ======================================== */
.custom-input-container {
    position: relative;
    margin-bottom: 24px;
    width: 100%;
}

.custom-input {
    width: 100%;
    padding: 16px 16px;
    font-size: 16px;
    background: transparent;
    border: 1px solid var(--md-sys-color-outline);
    border-radius: 8px;
    color: var(--md-sys-color-on-surface);
    outline: none;
    transition: all 0.2s ease;
    height: 56px;
    box-sizing: border-box;
    text-align: center;
    letter-spacing: 2px;
}

.custom-input:focus {
    border-color: var(--md-sys-color-primary);
    box-shadow: 0 0 0 1px var(--md-sys-color-primary);
}

.custom-label {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: var(--md-sys-color-on-surface-variant);
    pointer-events: none;
    transition: all 0.2s ease;
    font-size: 16px;
    background: transparent;
    padding: 0 4px;
}

/* Floating label effect */
.custom-input:focus~.custom-label,
.custom-input:not(:placeholder-shown)~.custom-label {
    top: 0;
    transform: translate(-50%, -50%) scale(0.85);
    background: var(--md-sys-color-surface-container-low);
    color: var(--md-sys-color-primary);
    font-weight: 500;
}

/* ========================================
   STAFF POS - Mobile Menu & Cart
   ======================================== */
.pos-container-mobile {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 160px);
    gap: 0;
}

.pos-container-mobile .section-header {
    padding: 0 0 12px 0;
}

.category-tabs-mobile {
    flex-shrink: 0;
}

.menu-grid-mobile {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    padding: 8px 0;
    overflow-y: auto;
    flex: 1;
    padding-bottom: 120px;
}

.menu-item-mobile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 12px 8px;
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-medium);
    cursor: pointer;
    transition: all 0.15s ease;
    text-align: center;
}

.menu-item-mobile:active {
    transform: scale(0.95);
    background: var(--md-sys-color-primary-container);
}

.menu-item-mobile .item-icon {
    font-size: 1.8rem;
}

.menu-item-mobile .item-name {
    font-size: var(--md-sys-typescale-label-small-size);
    font-weight: 500;
    color: var(--md-sys-color-on-surface);
    line-height: 1.2;
    max-height: 2.4em;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
}

.menu-item-mobile .item-price {
    font-size: var(--md-sys-typescale-label-small-size);
    font-weight: 600;
    color: var(--md-sys-color-primary);
}

/* Cart Summary Fixed Bottom */
.cart-summary-mobile {
    position: fixed;
    bottom: 90px;
    left: 16px;
    right: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    background: var(--md-sys-color-surface-container-high);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    box-shadow: var(--md-sys-elevation-level3);
    z-index: 50;
}

.cart-summary-mobile .cart-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.cart-summary-mobile .cart-count {
    font-size: var(--md-sys-typescale-label-medium-size);
    color: var(--md-sys-color-on-surface-variant);
}

.cart-summary-mobile .cart-total {
    font-size: var(--md-sys-typescale-title-medium-size);
    font-weight: 600;
    color: var(--md-sys-color-primary);
}

/* Responsive adjustments */
@media (min-width: 480px) {
    .menu-grid-mobile {
        grid-template-columns: repeat(4, 1fr);
    }
}

@media (min-width: 768px) {
    .menu-grid-mobile {
        grid-template-columns: repeat(5, 1fr);
    }
}
