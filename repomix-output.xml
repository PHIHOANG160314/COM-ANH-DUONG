    <!-- Lazy load non-critical modules for better performance -->
    <script>
        // Lazy load confetti when needed (checkout success)
        window.loadConfetti = async function () {
            if (window.Confetti) return window.Confetti;
            return new Promise((resolve) => {
                const script = document.createElement('script');
                script.src = 'js/confetti.js';
                script.onload = () => resolve(window.Confetti);
                document.head.appendChild(script);
            });
        };

        // Lazy load loyalty game when loyalty section is shown
        window.loadLoyaltyGame = async function () {
            if (window.LoyaltyGame) return window.LoyaltyGame;
            return new Promise((resolve) => {
                const script = document.createElement('script');
                script.src = 'js/loyalty-game.js';
                script.onload = () => resolve(window.LoyaltyGame);
                document.head.appendChild(script);
            });
        };

        // Lazy load social share when share is triggered
        window.loadSocialShare = async function () {
            if (window.SocialShare) return window.SocialShare;
            return new Promise((resolve) => {
                const script = document.createElement('script');
                script.src = 'js/social-share.js';
                script.onload = () => resolve(window.SocialShare);
                document.head.appendChild(script);
            });
        };

        // Load modules after page load
        window.addEventListener('load', () => {
            setTimeout(() => {
                // Preload these modules in idle time
                if ('requestIdleCallback' in window) {
                    requestIdleCallback(() => loadConfetti());
                    requestIdleCallback(() => loadLoyaltyGame());
                    requestIdleCallback(() => loadSocialShare());
                } else {
                    setTimeout(() => loadConfetti(), 2000);
                    setTimeout(() => loadLoyaltyGame(), 2500);
                    setTimeout(() => loadSocialShare(), 3000);
                }
            }, 1000);
        });
    </script>
