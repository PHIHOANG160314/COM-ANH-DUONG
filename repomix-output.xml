            .bar-fill {
                height: 100%;
                background: linear-gradient(90deg, var(--primary), var(--secondary));
                border-radius: 3px;
            }

            /* Staff Status */
            .staff-status {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 12px;
