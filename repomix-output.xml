<file path="css/ui-2026.css">
/* =========================================
   F&B MASTER - UI TRENDS 2026
   Glassmorphism, Micro-interactions, AI-Hints
   ========================================= */

:root {
    /* 🎨 Premium Color Palette 2026 */
    --primary-2026: #FF4B2B;
    /* Vibrant Orange-Red */
    --primary-glow: rgba(255, 75, 43, 0.4);
    --secondary-2026: #2B32B2;
    /* Deep Blue */
    --accent-neon: #00F260;
    /* Cyber Green for sustainability/vegan */
    --dark-bg: #0F172A;
    --dark-surface: #1E293B;

    /* 💎 Glassmorphism Variables */
    --glass-bg: rgba(255, 255, 255, 0.05);
    --glass-border: rgba(255, 255, 255, 0.1);
    --glass-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
    --glass-blur: blur(12px);

    /* 🌑 Dark Mode Glass */
    --glass-dark: rgba(15, 23, 42, 0.6);
    --glass-dark-border: rgba(255, 255, 255, 0.05);

    /* ⚡ Animation Integration */
    --ease-elastic: cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

/* =========================================
   CORE UI COMPONENTS
   ========================================= */

/* 1. GLASS CARD CONTAINER */
.glass-card {
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    border-radius: 24px;
    padding: 20px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.glass-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 40px 0 rgba(31, 38, 135, 0.45);
    border-color: rgba(255, 255, 255, 0.2);
}

/* 2. NEON BUTTONS with RIPPLE */
.btn-2026 {
    background: linear-gradient(135deg, var(--primary-2026) 0%, #FF416C 100%);
    border: none;
    border-radius: 50px;
    color: white;
    padding: 12px 24px;
    font-weight: 700;
    letter-spacing: 0.5px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s var(--ease-elastic);
    box-shadow: 0 4px 15px var(--primary-glow);
}

.btn-2026:active {
    transform: scale(0.95);
}

.btn-2026::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: width 0.6s ease, height 0.6s ease;
}

.btn-2026:active::after {
    width: 300px;
    height: 300px;
}

/* 3. PARALLAX HERO SECTION */
.hero-2026 {
    position: relative;
    height: 40vh;
    border-radius: 0 0 40px 40px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: 30px;
}

.hero-bg-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 120%;
    /* For parallax */
    object-fit: cover;
    z-index: -1;
    transition: transform 0.1s linear;
}

.hero-overlay {
    background: linear-gradient(to top, rgba(15, 23, 42, 0.9), transparent);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

.hero-content {
    position: relative;
    z-index: 2;
    color: white;
    animation: slideUpFade 0.8s ease-out;
}

/* 4. AI SUGGESTION CHIP */
.ai-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(0, 242, 96, 0.1);
    border: 1px solid rgba(0, 242, 96, 0.3);
    color: var(--accent-neon);
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    backdrop-filter: blur(4px);
}

.ai-chip i {
    animation: pulse-glow 2s infinite;
}

/* 5. FLOATING BOTTOM NAV */
.nav-float-2026 {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    max-width: 400px;
    background: rgba(30, 41, 59, 0.8);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 32px;
    display: flex;
    justify-content: space-around;
    padding: 12px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
    z-index: 1000;
}

.nav-item-2026 {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 0.75rem;
    gap: 4px;
    transition: all 0.3s ease;
}

.nav-item-2026.active {
    color: var(--primary-2026);
    transform: translateY(-4px);
}

.nav-item-2026.active i {
    filter: drop-shadow(0 0 8px var(--primary-glow));
}

/* =========================================
   ANIMATIONS
   ========================================= */

@keyframes pulse-glow {
    0% {
        box-shadow: 0 0 0 0 rgba(0, 242, 96, 0.4);
    }

    70% {
        box-shadow: 0 0 0 10px rgba(0, 242, 96, 0);
    }

    100% {
        box-shadow: 0 0 0 0 rgba(0, 242, 96, 0);
    }
}

@keyframes slideUpFade {
    from {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* =========================================
   SKELETON LOADING 2026
   ========================================= */
.skeleton-2026 {
    background: linear-gradient(90deg,
            rgba(255, 255, 255, 0.05) 25%,
            rgba(255, 255, 255, 0.1) 50%,
            rgba(255, 255, 255, 0.05) 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
    border-radius: 8px;
}

@keyframes shimmer {
    0% {
        background-position: 200% 0;
    }

    100% {
        background-position: -200% 0;
    }
}
</file>

