/* === ROBOTO FONT - M3 TYPOGRAPHY === */
@import url('https://fonts.googleapis.com/css2?family=Roboto:wght@100;300;400;500;700;900&display=swap');

:root {
    /* === M3 TYPOGRAPHY - Roboto === */
    --md-font-primary: 'Roboto', -apple-system, BlinkMacSystemFont, sans-serif;

    /* === M3 GRID SYSTEM === */
    --md-grid-columns: 12;
    --md-grid-gutter: 16px;
    --md-grid-margin: 16px;

    /* === M3 BREAKPOINTS (Window Size Classes) === */
    --md-breakpoint-compact: 600px;
    /* < 600dp: Mobile portrait */
    --md-breakpoint-medium: 840px;
    /* 600-839dp: Tablet portrait */
    --md-breakpoint-expanded: 1200px;
    /* 840-1199dp: Tablet landscape, desktop */
    --md-breakpoint-large: 1600px;
    /* 1200dp+: Large desktop */

    /* === M3 SPACING SCALE === */
    --md-spacing-xs: 4px;
    --md-spacing-sm: 8px;
    --md-spacing-md: 16px;
    --md-spacing-lg: 24px;
    --md-spacing-xl: 32px;
    --md-spacing-2xl: 48px;
    --md-spacing-3xl: 64px;
}

/* === BASE STYLES === */
body {
    font-family: var(--md-font-primary);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

/* =====================================================
