<file path="css/m3-typography.css">
/* =====================================================
   MATERIAL DESIGN 3 - TYPOGRAPHY SYSTEM
   Standardized type scale for Ánh Dương F&B
   ===================================================== */

/* Import Roboto (M3 default font) */
@import url('https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap');

/* =====================================================
   M3 TYPE SCALE CSS VARIABLES
   Based on Material Design 3 specifications
   ===================================================== */

:root {
    /* Font Family Stack - Roboto first (M3 default), Inter as fallback */
    --m3-font-family: 'Roboto', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    --m3-font-family-brand: 'Roboto', 'Inter', sans-serif;

    /* Display - Large hero text */
    --m3-display-large: 400 57px/64px var(--m3-font-family);
    --m3-display-medium: 400 45px/52px var(--m3-font-family);
    --m3-display-small: 400 36px/44px var(--m3-font-family);

    /* Headline - Section headers */
    --m3-headline-large: 400 32px/40px var(--m3-font-family);
    --m3-headline-medium: 400 28px/36px var(--m3-font-family);
    --m3-headline-small: 400 24px/32px var(--m3-font-family);

    /* Title - Card titles, dialogs */
    --m3-title-large: 400 22px/28px var(--m3-font-family);
    --m3-title-medium: 500 16px/24px var(--m3-font-family);
    --m3-title-small: 500 14px/20px var(--m3-font-family);

    /* Body - Main content */
    --m3-body-large: 400 16px/24px var(--m3-font-family);
    --m3-body-medium: 400 14px/20px var(--m3-font-family);
    --m3-body-small: 400 12px/16px var(--m3-font-family);

    /* Label - Buttons, form labels */
    --m3-label-large: 500 14px/20px var(--m3-font-family);
    --m3-label-medium: 500 12px/16px var(--m3-font-family);
    --m3-label-small: 500 11px/16px var(--m3-font-family);

    /* Letter spacing */
    --m3-tracking-tight: -0.25px;
    --m3-tracking-normal: 0px;
    --m3-tracking-wide: 0.1px;
    --m3-tracking-wider: 0.5px;
}

/* =====================================================
   GLOBAL TYPOGRAPHY RESET
   ===================================================== */

html {
    font-family: var(--m3-font-family);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
}

body {
    font: var(--m3-body-large);
    letter-spacing: var(--m3-tracking-normal);
}

/* =====================================================
   HEADING HIERARCHY - M3 Compliant
   ===================================================== */

h1 {
    font: var(--m3-display-large);
    letter-spacing: var(--m3-tracking-tight);
    margin: 0;
}

h2 {
    font: var(--m3-display-medium);
    letter-spacing: var(--m3-tracking-tight);
    margin: 0;
}

h3 {
    font: var(--m3-headline-large);
    letter-spacing: var(--m3-tracking-normal);
    margin: 0;
}

h4 {
    font: var(--m3-headline-medium);
    letter-spacing: var(--m3-tracking-normal);
    margin: 0;
}

h5 {
    font: var(--m3-title-large);
    letter-spacing: var(--m3-tracking-normal);
    margin: 0;
}

h6 {
    font: var(--m3-title-medium);
    letter-spacing: var(--m3-tracking-wide);
    margin: 0;
}

/* =====================================================
   BODY TEXT
   ===================================================== */

p {
    font: var(--m3-body-large);
    letter-spacing: var(--m3-tracking-normal);
    margin: 0 0 1em;
}

small {
    font: var(--m3-body-small);
}

/* =====================================================
   INTERACTIVE ELEMENTS
   ===================================================== */

button,
.btn,
.md-button,
[class*="btn-"] {
    font: var(--m3-label-large);
    letter-spacing: var(--m3-tracking-wide);
}

/* =====================================================
   NAVIGATION & LINKS
   ===================================================== */

nav a,
.nav-links a,
.nav-item {
    font: var(--m3-label-large);
    letter-spacing: var(--m3-tracking-wide);
}

/* =====================================================
   FORM ELEMENTS
   ===================================================== */

input,
textarea,
select {
    font: var(--m3-body-large);
}

label {
    font: var(--m3-label-medium);
    letter-spacing: var(--m3-tracking-wider);
}

/* =====================================================
   UTILITY CLASSES
   ===================================================== */

.m3-display-large {
    font: var(--m3-display-large) !important;
}

.m3-display-medium {
    font: var(--m3-display-medium) !important;
}

.m3-display-small {
    font: var(--m3-display-small) !important;
}

.m3-headline-large {
    font: var(--m3-headline-large) !important;
}

.m3-headline-medium {
    font: var(--m3-headline-medium) !important;
}

.m3-headline-small {
    font: var(--m3-headline-small) !important;
}

.m3-title-large {
    font: var(--m3-title-large) !important;
}

.m3-title-medium {
    font: var(--m3-title-medium) !important;
}

.m3-title-small {
    font: var(--m3-title-small) !important;
}

.m3-body-large {
    font: var(--m3-body-large) !important;
}

.m3-body-medium {
    font: var(--m3-body-medium) !important;
}

.m3-body-small {
    font: var(--m3-body-small) !important;
}

.m3-label-large {
    font: var(--m3-label-large) !important;
}

.m3-label-medium {
    font: var(--m3-label-medium) !important;
}

.m3-label-small {
    font: var(--m3-label-small) !important;
}

/* =====================================================
   RESPONSIVE TYPOGRAPHY
   ===================================================== */

@media (max-width: 768px) {
    :root {
        /* Slightly smaller display sizes on mobile */
        --m3-display-large: 400 45px/52px var(--m3-font-family);
        --m3-display-medium: 400 36px/44px var(--m3-font-family);
        --m3-display-small: 400 32px/40px var(--m3-font-family);
        --m3-headline-large: 400 28px/36px var(--m3-font-family);
    }
}

@media (max-width: 480px) {
    :root {
        /* Even smaller for very small screens */
        --m3-display-large: 400 36px/44px var(--m3-font-family);
        --m3-display-medium: 400 32px/40px var(--m3-font-family);
        --m3-display-small: 400 28px/36px var(--m3-font-family);
        --m3-headline-large: 400 24px/32px var(--m3-font-family);
    }
}
