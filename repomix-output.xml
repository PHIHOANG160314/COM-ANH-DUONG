      'create-payment',
      {
        body: {
          orderId,
          amount,
          provider,
          language,
          ipAddr: '127.0.0.1', // In a real app, the Edge Function should extract this from headers if possible, or we rely on the function to handle it.
        },
      }
    );

    if (error) {
      throw error;
    }

    return data;
  },
};
