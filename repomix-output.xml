    --md-sys-typescale-headline-medium-weight: 400;
    --md-sys-typescale-headline-medium-line-height: 36px;

    --md-sys-typescale-headline-small-size: 24px;
    --md-sys-typescale-headline-small-weight: 400;
    --md-sys-typescale-headline-small-line-height: 32px;

    /* Title */
    --md-sys-typescale-title-large-size: 22px;
    --md-sys-typescale-title-large-weight: 400;
    --md-sys-typescale-title-large-line-height: 28px;

    --md-sys-typescale-title-medium-size: 16px;
    --md-sys-typescale-title-medium-weight: 500;
    --md-sys-typescale-title-medium-line-height: 24px;

    --md-sys-typescale-title-small-size: 14px;
    --md-sys-typescale-title-small-weight: 500;
    --md-sys-typescale-title-small-line-height: 20px;

    /* Body */
    --md-sys-typescale-body-large-size: 16px;
    --md-sys-typescale-body-large-weight: 400;
    --md-sys-typescale-body-large-line-height: 24px;

    --md-sys-typescale-body-medium-size: 14px;
    --md-sys-typescale-body-medium-weight: 400;
    --md-sys-typescale-body-medium-line-height: 20px;

    --md-sys-typescale-body-small-size: 12px;
    --md-sys-typescale-body-small-weight: 400;
    --md-sys-typescale-body-small-line-height: 16px;

    /* Label */
    --md-sys-typescale-label-large-size: 14px;
    --md-sys-typescale-label-large-weight: 500;
    --md-sys-typescale-label-large-line-height: 20px;

    --md-sys-typescale-label-medium-size: 12px;
    --md-sys-typescale-label-medium-weight: 500;
    --md-sys-typescale-label-medium-line-height: 16px;

    --md-sys-typescale-label-small-size: 11px;
    --md-sys-typescale-label-small-weight: 500;
    --md-sys-typescale-label-small-line-height: 16px;

    /* =====================================================
       M3 SHAPE - CORNER STYLES
       ===================================================== */

    --md-sys-shape-corner-none: 0px;
    --md-sys-shape-corner-extra-small: 4px;
    --md-sys-shape-corner-small: 8px;
    --md-sys-shape-corner-medium: 12px;
    --md-sys-shape-corner-large: 16px;
    --md-sys-shape-corner-extra-large: 28px;
    --md-sys-shape-corner-full: 9999px;

    /* =====================================================
       M3 ELEVATION - SHADOW LEVELS
       ===================================================== */

    --md-sys-elevation-level0: none;
    --md-sys-elevation-level1: 0 1px 2px 0 rgba(0, 0, 0, 0.3), 0 1px 3px 1px rgba(0, 0, 0, 0.15);
    --md-sys-elevation-level2: 0 1px 2px 0 rgba(0, 0, 0, 0.3), 0 2px 6px 2px rgba(0, 0, 0, 0.15);
    --md-sys-elevation-level3: 0 1px 3px 0 rgba(0, 0, 0, 0.3), 0 4px 8px 3px rgba(0, 0, 0, 0.15);
    --md-sys-elevation-level4: 0 2px 3px 0 rgba(0, 0, 0, 0.3), 0 6px 10px 4px rgba(0, 0, 0, 0.15);
    --md-sys-elevation-level5: 0 4px 4px 0 rgba(0, 0, 0, 0.3), 0 8px 12px 6px rgba(0, 0, 0, 0.15);

    /* =====================================================
       M3 MOTION - ANIMATION & TRANSITION
       ===================================================== */

    --md-sys-motion-duration-short1: 50ms;
    --md-sys-motion-duration-short2: 100ms;
    --md-sys-motion-duration-short3: 150ms;
    --md-sys-motion-duration-short4: 200ms;
    --md-sys-motion-duration-medium1: 250ms;
    --md-sys-motion-duration-medium2: 300ms;
    --md-sys-motion-duration-medium3: 350ms;
    --md-sys-motion-duration-medium4: 400ms;
    --md-sys-motion-duration-long1: 450ms;
    --md-sys-motion-duration-long2: 500ms;
    --md-sys-motion-duration-long3: 550ms;
    --md-sys-motion-duration-long4: 600ms;
    --md-sys-motion-duration-extra-long1: 700ms;
    --md-sys-motion-duration-extra-long2: 800ms;
    --md-sys-motion-duration-extra-long3: 900ms;
    --md-sys-motion-duration-extra-long4: 1000ms;

    --md-sys-motion-easing-emphasized: cubic-bezier(0.2, 0, 0, 1);
    --md-sys-motion-easing-emphasized-accelerate: cubic-bezier(0.3, 0, 0.8, 0.15);
    --md-sys-motion-easing-emphasized-decelerate: cubic-bezier(0.05, 0.7, 0.1, 1);
    --md-sys-motion-easing-standard: cubic-bezier(0.2, 0, 0, 1);
    --md-sys-motion-easing-standard-accelerate: cubic-bezier(0.3, 0, 1, 1);
    --md-sys-motion-easing-standard-decelerate: cubic-bezier(0, 0, 0, 1);
    --md-sys-motion-easing-legacy: cubic-bezier(0.4, 0, 0.2, 1);
    --md-sys-motion-easing-linear: cubic-bezier(0, 0, 1, 1);
}

/* =====================================================
   M3 DARK THEME
   ===================================================== */

[data-theme="dark"],
.dark-theme {
    /* === PRIMARY - Green Dark Theme === */
    --md-sys-color-primary: #7CDC70;
    --md-sys-color-on-primary: #003A00;
    --md-sys-color-primary-container: #005000;
    --md-sys-color-on-primary-container: #A8F0A0;

    /* === SECONDARY - Logo Green #73C249 === */
    --md-sys-color-secondary: #98DF6A;
    --md-sys-color-on-secondary: #173800;
    --md-sys-color-secondary-container: #245100;
    --md-sys-color-on-secondary-container: #B4FC85;

    /* === TERTIARY === */
    --md-sys-color-tertiary: #F5BF48;
    --md-sys-color-on-tertiary: #422D00;
    --md-sys-color-tertiary-container: #5F4200;
    --md-sys-color-on-tertiary-container: #FFDEAB;

    /* === ERROR === */
    --md-sys-color-error: #FFB4AB;
    --md-sys-color-on-error: #690005;
    --md-sys-color-error-container: #93000A;
    --md-sys-color-on-error-container: #FFDAD6;

    /* === SURFACE - Green Tinted Dark === */
    --md-sys-color-surface: #121410;
    --md-sys-color-on-surface: #E2E3DC;
    --md-sys-color-surface-variant: #424940;
    --md-sys-color-on-surface-variant: #C2C9BD;
    --md-sys-color-background: #121410;
    --md-sys-color-on-background: #E2E3DC;
    --md-sys-color-outline: #8C9388;
    --md-sys-color-outline-variant: #424940;
    --md-sys-color-inverse-surface: #E2E3DC;
    --md-sys-color-inverse-on-surface: #2F312C;
    --md-sys-color-inverse-primary: #006400;
    --md-sys-color-surface-dim: #121410;
    --md-sys-color-surface-bright: #383A35;
    --md-sys-color-surface-container-lowest: #0D0F0B;
    --md-sys-color-surface-container-low: #1A1C18;
    --md-sys-color-surface-container: #1E201B;
    --md-sys-color-surface-container-high: #282A25;
    --md-sys-color-surface-container-highest: #333530;
}

@media (prefers-color-scheme: dark) {
    :root {
        /* === PRIMARY - Green Dark Theme (Auto) === */
        --md-sys-color-primary: #7CDC70;
        --md-sys-color-on-primary: #003A00;
        --md-sys-color-primary-container: #005000;
        --md-sys-color-on-primary-container: #A8F0A0;
        --md-sys-color-secondary: #98DF6A;
        --md-sys-color-on-secondary: #173800;
        --md-sys-color-secondary-container: #245100;
        --md-sys-color-on-secondary-container: #B4FC85;
        --md-sys-color-tertiary: #F5BF48;
        --md-sys-color-on-tertiary: #422D00;
        --md-sys-color-tertiary-container: #5F4200;
        --md-sys-color-on-tertiary-container: #FFDEAB;
        --md-sys-color-error: #FFB4AB;
        --md-sys-color-on-error: #690005;
        --md-sys-color-error-container: #93000A;
        --md-sys-color-on-error-container: #FFDAD6;
        --md-sys-color-surface: #121410;
        --md-sys-color-on-surface: #E2E3DC;
        --md-sys-color-surface-variant: #424940;
        --md-sys-color-on-surface-variant: #C2C9BD;
        --md-sys-color-background: #121410;
        --md-sys-color-on-background: #E2E3DC;
        --md-sys-color-outline: #8C9388;
        --md-sys-color-outline-variant: #424940;
        --md-sys-color-inverse-surface: #E2E3DC;
        --md-sys-color-inverse-on-surface: #2F312C;
        --md-sys-color-inverse-primary: #006400;
        --md-sys-color-surface-dim: #121410;
        --md-sys-color-surface-bright: #383A35;
        --md-sys-color-surface-container-lowest: #0D0F0B;
        --md-sys-color-surface-container-low: #1A1C18;
        --md-sys-color-surface-container: #1E201B;
        --md-sys-color-surface-container-high: #282A25;
        --md-sys-color-surface-container-highest: #333530;
    }
}

/* =====================================================
   ÁNH DƯƠNG CUSTOM THEME - F&B Brand Colors
   Override M3 with brand colors
   ===================================================== */

:root {
    /* Brand Primary - Dark Green from Logo #006400 */
    --ad-color-primary: #006400;
    --ad-color-on-primary: #FFFFFF;
    --ad-color-primary-container: #A8F0A0;
    --ad-color-on-primary-container: #002204;

    /* Brand Secondary - Light Green from Logo #73C249 */
    --ad-color-secondary: #73C249;
    --ad-color-on-secondary: #FFFFFF;
    --ad-color-secondary-container: #D0F0BD;
    --ad-color-on-secondary-container: #0C2004;

    /* Brand Tertiary - Gold/Premium (complementary) */
    --ad-color-tertiary: #FFB300;
    --ad-color-on-tertiary: #000000;
    --ad-color-tertiary-container: #FFDEAB;
    --ad-color-on-tertiary-container: #4E3B00;

    /* =====================================================
       SEMANTIC COLORS - Ánh Dương Extended
       ===================================================== */

    /* Success - Green */
    --ad-color-success: #4CAF50;
    --ad-color-on-success: #FFFFFF;
    --ad-color-success-container: #E8F5E9;
    --ad-color-on-success-container: #1B5E20;

    /* Warning - Amber */
    --ad-color-warning: #FF9800;
    --ad-color-on-warning: #000000;
    --ad-color-warning-container: #FFF3E0;
    --ad-color-on-warning-container: #E65100;

    /* Info - Blue */
    --ad-color-info: #2196F3;
    --ad-color-on-info: #FFFFFF;
    --ad-color-info-container: #E3F2FD;
    --ad-color-on-info-container: #0D47A1;

    /* Danger - Red (extends error) */
    --ad-color-danger: #F44336;
    --ad-color-on-danger: #FFFFFF;
    --ad-color-danger-container: #FFEBEE;
    --ad-color-on-danger-container: #B71C1C;

    /* =====================================================
       STATUS COLORS - Order/Kitchen Status
       ===================================================== */

    /* Pending - Yellow */
    --ad-status-pending: #FFC107;
    --ad-status-pending-bg: #FFF8E1;

    /* Preparing - Blue */
    --ad-status-preparing: #2196F3;
    --ad-status-preparing-bg: #E3F2FD;

    /* Ready - Orange */
    --ad-status-ready: #FF9800;
    --ad-status-ready-bg: #FFF3E0;

    /* Completed - Green */
    --ad-status-completed: #4CAF50;
    --ad-status-completed-bg: #E8F5E9;

    /* Cancelled - Grey */
    --ad-status-cancelled: #9E9E9E;
    --ad-status-cancelled-bg: #F5F5F5;

    /* =====================================================
       EXTENDED PALETTE - Gradients & Accents
       ===================================================== */

    /* Gradient Colors - Green Based from Logo */
    --ad-gradient-primary: linear-gradient(135deg, #006400 0%, #2E7D32 100%);
    --ad-gradient-secondary: linear-gradient(135deg, #73C249 0%, #8BC34A 100%);
    --ad-gradient-tertiary: linear-gradient(135deg, #FFB300 0%, #FFCA28 100%);
    --ad-gradient-premium: linear-gradient(135deg, #FFD700 0%, #FFA000 100%);
    --ad-gradient-dark: linear-gradient(135deg, #121410 0%, #1A2218 100%);

    /* Accent Colors */
    --ad-accent-pink: #E91E63;
    --ad-accent-purple: #9C27B0;
    --ad-accent-indigo: #3F51B5;
    --ad-accent-cyan: #00BCD4;
    --ad-accent-teal: #009688;
    --ad-accent-lime: #CDDC39;

    /* =====================================================
       APPLY BRAND TO M3 TOKENS
       ===================================================== */

    --md-sys-color-primary: var(--ad-color-primary);
    --md-sys-color-on-primary: var(--ad-color-on-primary);
    --md-sys-color-primary-container: var(--ad-color-primary-container);
    --md-sys-color-on-primary-container: var(--ad-color-on-primary-container);

    --md-sys-color-secondary: var(--ad-color-secondary);
    --md-sys-color-on-secondary: var(--ad-color-on-secondary);
    --md-sys-color-secondary-container: var(--ad-color-secondary-container);
    --md-sys-color-on-secondary-container: var(--ad-color-on-secondary-container);

    --md-sys-color-tertiary: var(--ad-color-tertiary);
    --md-sys-color-on-tertiary: var(--ad-color-on-tertiary);
    --md-sys-color-tertiary-container: var(--ad-color-tertiary-container);
    --md-sys-color-on-tertiary-container: var(--ad-color-on-tertiary-container);
}

/* =====================================================
   M3 UTILITY CLASSES
   ===================================================== */

/* Typography */
.md-display-large {
    font-family: var(--md-sys-typescale-display-large-font);
    font-size: var(--md-sys-typescale-display-large-size);
    font-weight: var(--md-sys-typescale-display-large-weight);
    line-height: var(--md-sys-typescale-display-large-line-height);
}

.md-headline-large {
    font-size: var(--md-sys-typescale-headline-large-size);
    font-weight: var(--md-sys-typescale-headline-large-weight);
    line-height: var(--md-sys-typescale-headline-large-line-height);
}

.md-title-large {
    font-size: var(--md-sys-typescale-title-large-size);
    font-weight: var(--md-sys-typescale-title-large-weight);
    line-height: var(--md-sys-typescale-title-large-line-height);
}

.md-title-medium {
    font-size: var(--md-sys-typescale-title-medium-size);
    font-weight: var(--md-sys-typescale-title-medium-weight);
    line-height: var(--md-sys-typescale-title-medium-line-height);
}

.md-body-large {
    font-size: var(--md-sys-typescale-body-large-size);
    font-weight: var(--md-sys-typescale-body-large-weight);
    line-height: var(--md-sys-typescale-body-large-line-height);
}

.md-body-medium {
    font-size: var(--md-sys-typescale-body-medium-size);
    font-weight: var(--md-sys-typescale-body-medium-weight);
    line-height: var(--md-sys-typescale-body-medium-line-height);
}

.md-label-large {
    font-size: var(--md-sys-typescale-label-large-size);
    font-weight: var(--md-sys-typescale-label-large-weight);
    line-height: var(--md-sys-typescale-label-large-line-height);
}

/* Surfaces */
.md-surface {
    background: var(--md-sys-color-surface);
    color: var(--md-sys-color-on-surface);
}

.md-surface-variant {
    background: var(--md-sys-color-surface-variant);
    color: var(--md-sys-color-on-surface-variant);
}

.md-surface-container {
    background: var(--md-sys-color-surface-container);
}

.md-surface-container-high {
    background: var(--md-sys-color-surface-container-high);
}

.md-surface-container-highest {
    background: var(--md-sys-color-surface-container-highest);
}

/* Elevation */
.md-elevation-1 {
    box-shadow: var(--md-sys-elevation-level1);
}

.md-elevation-2 {
    box-shadow: var(--md-sys-elevation-level2);
}

.md-elevation-3 {
    box-shadow: var(--md-sys-elevation-level3);
}

.md-elevation-4 {
    box-shadow: var(--md-sys-elevation-level4);
}

.md-elevation-5 {
    box-shadow: var(--md-sys-elevation-level5);
}

/* Shapes */
.md-shape-extra-small {
    border-radius: var(--md-sys-shape-corner-extra-small);
}

.md-shape-small {
    border-radius: var(--md-sys-shape-corner-small);
}

.md-shape-medium {
    border-radius: var(--md-sys-shape-corner-medium);
}

.md-shape-large {
    border-radius: var(--md-sys-shape-corner-large);
}

.md-shape-extra-large {
    border-radius: var(--md-sys-shape-corner-extra-large);
}

.md-shape-full {
    border-radius: var(--md-sys-shape-corner-full);
}

/* State Layer (for interactive elements) */
.md-state-layer {
    position: relative;
    overflow: hidden;
}

.md-state-layer::before {
    content: '';
    position: absolute;
    inset: 0;
    background: currentColor;
    opacity: 0;
    transition: opacity var(--md-sys-motion-duration-short2) var(--md-sys-motion-easing-standard);
    pointer-events: none;
}

.md-state-layer:hover::before {
    opacity: 0.08;
}

.md-state-layer:focus::before {
    opacity: 0.12;
}

.md-state-layer:active::before {
    opacity: 0.12;
}

/* M3 Buttons */
.md-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 24px;
    border: none;
    border-radius: var(--md-sys-shape-corner-full);
    font-size: var(--md-sys-typescale-label-large-size);
    font-weight: var(--md-sys-typescale-label-large-weight);
    cursor: pointer;
    transition: all var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
}

.md-button-filled {
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
}

.md-button-filled:hover {
    box-shadow: var(--md-sys-elevation-level1);
}

.md-button-outlined {
    background: transparent;
    color: var(--md-sys-color-primary);
    border: 1px solid var(--md-sys-color-outline);
}

.md-button-tonal {
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
}

.md-button-text {
    background: transparent;
    color: var(--md-sys-color-primary);
    padding: 0 12px;
}

/* M3 FAB */
.md-fab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border: none;
    border-radius: var(--md-sys-shape-corner-large);
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    box-shadow: var(--md-sys-elevation-level3);
    cursor: pointer;
    transition: all var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-emphasized);
}

.md-fab:hover {
    box-shadow: var(--md-sys-elevation-level4);
}

.md-fab-small {
    width: 40px;
    height: 40px;
    border-radius: var(--md-sys-shape-corner-medium);
}

.md-fab-large {
    width: 96px;
    height: 96px;
    border-radius: var(--md-sys-shape-corner-extra-large);
    font-size: 36px;
}

/* M3 Card */
.md-card {
    background: var(--md-sys-color-surface-container-low);
    border-radius: var(--md-sys-shape-corner-medium);
    overflow: hidden;
}

.md-card-elevated {
    box-shadow: var(--md-sys-elevation-level1);
}

.md-card-filled {
    background: var(--md-sys-color-surface-container-highest);
}

.md-card-outlined {
    background: var(--md-sys-color-surface);
    border: 1px solid var(--md-sys-color-outline-variant);
}

/* M3 Chip */
.md-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding: 0 16px;
    border-radius: var(--md-sys-shape-corner-small);
    font-size: var(--md-sys-typescale-label-large-size);
    cursor: pointer;
}

.md-chip-assist {
    background: var(--md-sys-color-surface);
    border: 1px solid var(--md-sys-color-outline);
    color: var(--md-sys-color-on-surface);
}

.md-chip-filter {
    background: var(--md-sys-color-surface-container-low);
    color: var(--md-sys-color-on-surface-variant);
}

.md-chip-filter.selected {
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
}

/* M3 Badge */
.md-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: var(--md-sys-shape-corner-full);
    background: var(--md-sys-color-error);
    color: var(--md-sys-color-on-error);
    font-size: 11px;
    font-weight: 500;
}

.md-badge-large {
    min-width: 24px;
    height: 24px;
    padding: 0 8px;
    font-size: 12px;
}

/* M3 Divider */
.md-divider {
    height: 1px;
    background: var(--md-sys-color-outline-variant);
    margin: 0;
    border: none;
}

/* M3 Icon */
.md-icon {
    font-size: 24px;
    width: 24px;
    height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

/* M3 Navigation Bar */
.md-navigation-bar {
    display: flex;
    justify-content: space-around;
    align-items: center;
    height: 80px;
    background: var(--md-sys-color-surface-container);
    padding-bottom: env(safe-area-inset-bottom);
}

.md-navigation-bar-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 12px 16px;
    cursor: pointer;
    color: var(--md-sys-color-on-surface-variant);
    transition: color var(--md-sys-motion-duration-short2);
}

.md-navigation-bar-item.active {
    color: var(--md-sys-color-on-surface);
}

.md-navigation-bar-item .indicator {
    width: 64px;
    height: 32px;
    border-radius: var(--md-sys-shape-corner-full);
    display: flex;
    align-items: center;
    justify-content: center;
}

.md-navigation-bar-item.active .indicator {
    background: var(--md-sys-color-secondary-container);
}

/* M3 Snackbar */
.md-snackbar {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 288px;
    max-width: 560px;
    padding: 14px 16px;
    background: var(--md-sys-color-inverse-surface);
    color: var(--md-sys-color-inverse-on-surface);
    border-radius: var(--md-sys-shape-corner-extra-small);
    box-shadow: var(--md-sys-elevation-level3);
}

/* M3 Dialog */
.md-dialog {
    background: var(--md-sys-color-surface-container-high);
    border-radius: var(--md-sys-shape-corner-extra-large);
    padding: 24px;
    min-width: 280px;
    max-width: 560px;
    box-shadow: var(--md-sys-elevation-level3);
}

.md-dialog-title {
    font-size: var(--md-sys-typescale-headline-small-size);
    margin-bottom: 16px;
}

.md-dialog-content {
    font-size: var(--md-sys-typescale-body-medium-size);
    color: var(--md-sys-color-on-surface-variant);
    margin-bottom: 24px;
}

.md-dialog-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
}

/* =====================================================
   ÁNH DƯƠNG UTILITY CLASSES
   ===================================================== */

/* Semantic Button Variants */
.md-button-success {
    background: var(--ad-color-success);
    color: var(--ad-color-on-success);
}

.md-button-warning {
    background: var(--ad-color-warning);
    color: var(--ad-color-on-warning);
}

.md-button-info {
    background: var(--ad-color-info);
    color: var(--ad-color-on-info);
}

.md-button-danger {
    background: var(--ad-color-danger);
    color: var(--ad-color-on-danger);
}

/* Status Badges */
.ad-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: var(--md-sys-shape-corner-full);
    font-size: var(--md-sys-typescale-label-medium-size);
    font-weight: 500;
}

.ad-status-pending {
    background: var(--ad-status-pending-bg);
    color: var(--ad-status-pending);
}

.ad-status-preparing {
    background: var(--ad-status-preparing-bg);
    color: var(--ad-status-preparing);
}

.ad-status-ready {
    background: var(--ad-status-ready-bg);
    color: var(--ad-status-ready);
}

.ad-status-completed {
    background: var(--ad-status-completed-bg);
    color: var(--ad-status-completed);
}

.ad-status-cancelled {
    background: var(--ad-status-cancelled-bg);
    color: var(--ad-status-cancelled);
}

/* Gradient Backgrounds */
.ad-bg-primary {
    background: var(--ad-gradient-primary);
}

.ad-bg-secondary {
    background: var(--ad-gradient-secondary);
}

.ad-bg-tertiary {
    background: var(--ad-gradient-tertiary);
}

.ad-bg-premium {
    background: var(--ad-gradient-premium);
}

.ad-bg-dark {
    background: var(--ad-gradient-dark);
    color: white;
}

/* Alert/Toast Variants */
.ad-alert {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-radius: var(--md-sys-shape-corner-medium);
    font-size: var(--md-sys-typescale-body-medium-size);
}

.ad-alert-success {
    background: var(--ad-color-success-container);
    color: var(--ad-color-on-success-container);
}

.ad-alert-warning {
    background: var(--ad-color-warning-container);
    color: var(--ad-color-on-warning-container);
}

.ad-alert-info {
    background: var(--ad-color-info-container);
    color: var(--ad-color-on-info-container);
}

.ad-alert-danger {
    background: var(--ad-color-danger-container);
    color: var(--ad-color-on-danger-container);
}

/* Print Debug */
@media print {

    .md-elevation-1,
    .md-elevation-2,
    .md-elevation-3,
    .md-elevation-4,
    .md-elevation-5 {
        box-shadow: none !important;
        border: 1px solid var(--md-sys-color-outline);
    }
}

/* =====================================================
   M3 TEXT FIELDS
   ===================================================== */

.md-text-field {
    position: relative;
    width: 100%;
}

.md-text-field input,
.md-text-field textarea {
    width: 100%;
    padding: 16px;
    font-family: inherit;
    font-size: var(--md-sys-typescale-body-large-size);
    line-height: var(--md-sys-typescale-body-large-line-height);
    border: none;
    outline: none;
    transition: all var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
}

/* Filled Text Field */
.md-text-field-filled input,
.md-text-field-filled textarea {
    background: var(--md-sys-color-surface-container-highest);
    border-radius: var(--md-sys-shape-corner-extra-small) var(--md-sys-shape-corner-extra-small) 0 0;
    border-bottom: 1px solid var(--md-sys-color-on-surface-variant);
    color: var(--md-sys-color-on-surface);
}

.md-text-field-filled input:focus,
.md-text-field-filled textarea:focus {
    border-bottom: 2px solid var(--md-sys-color-primary);
}

.md-text-field-filled input::placeholder,
.md-text-field-filled textarea::placeholder {
    color: var(--md-sys-color-on-surface-variant);
}

/* Outlined Text Field */
.md-text-field-outlined input,
.md-text-field-outlined textarea {
    background: transparent;
    border: 1px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-corner-extra-small);
    color: var(--md-sys-color-on-surface);
}

.md-text-field-outlined input:focus,
.md-text-field-outlined textarea:focus {
    border: 2px solid var(--md-sys-color-primary);
    padding: 15px;
}

.md-text-field-outlined input::placeholder,
.md-text-field-outlined textarea::placeholder {
    color: var(--md-sys-color-on-surface-variant);
}

/* Text Field Error State */
.md-text-field-error input,
.md-text-field-error textarea {
    border-color: var(--md-sys-color-error) !important;
}

.md-text-field-helper {
    font-size: var(--md-sys-typescale-body-small-size);
    color: var(--md-sys-color-on-surface-variant);
    padding: 4px 16px 0;
}

.md-text-field-error .md-text-field-helper {
    color: var(--md-sys-color-error);
}

/* =====================================================
   M3 SWITCH / TOGGLE
   ===================================================== */

.md-switch {
    position: relative;
    display: inline-flex;
    align-items: center;
    cursor: pointer;
}

.md-switch input {
    opacity: 0;
    width: 0;
    height: 0;
}

.md-switch-track {
    width: 52px;
    height: 32px;
    background: var(--md-sys-color-surface-container-highest);
    border: 2px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-corner-full);
    transition: all var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
    position: relative;
}

.md-switch-thumb {
    position: absolute;
    width: 16px;
    height: 16px;
    background: var(--md-sys-color-outline);
    border-radius: 50%;
    top: 50%;
    left: 8px;
    transform: translateY(-50%);
    transition: all var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-emphasized);
}

.md-switch input:checked+.md-switch-track {
    background: var(--md-sys-color-primary);
    border-color: var(--md-sys-color-primary);
}

.md-switch input:checked+.md-switch-track .md-switch-thumb {
    left: 28px;
    width: 24px;
    height: 24px;
    background: var(--md-sys-color-on-primary);
}

/* =====================================================
   M3 PROGRESS INDICATORS
   ===================================================== */

/* Linear Progress */
.md-progress-linear {
    width: 100%;
    height: 4px;
    background: var(--md-sys-color-surface-container-highest);
    border-radius: var(--md-sys-shape-corner-full);
    overflow: hidden;
}

.md-progress-linear-bar {
    height: 100%;
    background: var(--md-sys-color-primary);
    border-radius: var(--md-sys-shape-corner-full);
    transition: width var(--md-sys-motion-duration-medium2) var(--md-sys-motion-easing-standard);
}

.md-progress-linear-indeterminate .md-progress-linear-bar {
    width: 50%;
    animation: md-progress-indeterminate 2s infinite var(--md-sys-motion-easing-standard);
}

@keyframes md-progress-indeterminate {
    0% {
        transform: translateX(-100%);
    }

    100% {
        transform: translateX(300%);
    }
}

/* Circular Progress */
.md-progress-circular {
    width: 48px;
    height: 48px;
    position: relative;
}

.md-progress-circular svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
}

.md-progress-circular-track {
    fill: none;
    stroke: var(--md-sys-color-surface-container-highest);
    stroke-width: 4;
}

.md-progress-circular-bar {
    fill: none;
    stroke: var(--md-sys-color-primary);
    stroke-width: 4;
    stroke-linecap: round;
    transition: stroke-dasharray var(--md-sys-motion-duration-medium2);
}

.md-progress-circular-indeterminate {
    animation: md-circular-rotate 2s linear infinite;
}

.md-progress-circular-indeterminate .md-progress-circular-bar {
    animation: md-circular-dash 1.5s ease-in-out infinite;
}

@keyframes md-circular-rotate {
    100% {
        transform: rotate(360deg);
    }
}

@keyframes md-circular-dash {
    0% {
        stroke-dasharray: 1, 150;
        stroke-dashoffset: 0;
    }

    50% {
        stroke-dasharray: 90, 150;
        stroke-dashoffset: -35;
    }

    100% {
        stroke-dasharray: 90, 150;
        stroke-dashoffset: -124;
    }
}

/* =====================================================
   M3 TOP APP BAR
   ===================================================== */

.md-top-app-bar {
    display: flex;
    align-items: center;
    height: 64px;
    padding: 0 16px;
    background: var(--md-sys-color-surface);
    color: var(--md-sys-color-on-surface);
}

.md-top-app-bar-title {
    flex: 1;
    font-size: var(--md-sys-typescale-title-large-size);
    font-weight: var(--md-sys-typescale-title-large-weight);
    margin-left: 16px;
}

.md-top-app-bar-center-aligned {
    justify-content: center;
}

.md-top-app-bar-center-aligned .md-top-app-bar-title {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    margin-left: 0;
}

.md-top-app-bar-small {
    height: 56px;
}

.md-top-app-bar-medium {
    height: 112px;
    flex-wrap: wrap;
    align-content: flex-start;
    padding-top: 8px;
}

.md-top-app-bar-large {
    height: 152px;
    flex-wrap: wrap;
    align-content: flex-start;
    padding-top: 8px;
}

.md-top-app-bar-medium .md-top-app-bar-title,
.md-top-app-bar-large .md-top-app-bar-title {
    width: 100%;
    margin-left: 0;
    padding: 24px 16px 0;
    font-size: var(--md-sys-typescale-headline-small-size);
}

.md-top-app-bar-large .md-top-app-bar-title {
    font-size: var(--md-sys-typescale-headline-medium-size);
}

/* =====================================================
   M3 LIST
   ===================================================== */

.md-list {
    display: flex;
    flex-direction: column;
    padding: 8px 0;
}

.md-list-item {
    display: flex;
    align-items: center;
    min-height: 56px;
    padding: 8px 16px;
    gap: 16px;
    cursor: pointer;
    transition: background var(--md-sys-motion-duration-short2) var(--md-sys-motion-easing-standard);
}

.md-list-item:hover {
    background: rgba(var(--md-sys-color-on-surface), 0.08);
}

.md-list-item-leading {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    flex-shrink: 0;
}

.md-list-item-content {
    flex: 1;
    min-width: 0;
}

.md-list-item-headline {
    font-size: var(--md-sys-typescale-body-large-size);
    color: var(--md-sys-color-on-surface);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.md-list-item-supporting {
    font-size: var(--md-sys-typescale-body-medium-size);
    color: var(--md-sys-color-on-surface-variant);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.md-list-item-trailing {
    flex-shrink: 0;
    color: var(--md-sys-color-on-surface-variant);
}

/* Two-line and Three-line list items */
.md-list-item-two-line {
    min-height: 72px;
}

.md-list-item-three-line {
    min-height: 88px;
    align-items: flex-start;
    padding-top: 12px;
    padding-bottom: 12px;
}

.md-list-item-three-line .md-list-item-supporting {
    white-space: normal;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
}

/* =====================================================
   M3 ICON BUTTON
   ===================================================== */

.md-icon-button {
    width: 48px;
    height: 48px;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--md-sys-color-on-surface-variant);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    transition: background var(--md-sys-motion-duration-short2) var(--md-sys-motion-easing-standard);
}

.md-icon-button:hover {
    background: var(--md-sys-color-surface-container-highest);
}

.md-icon-button-filled {
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
}

.md-icon-button-filled:hover {
    box-shadow: var(--md-sys-elevation-level1);
}

.md-icon-button-tonal {
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
}

.md-icon-button-outlined {
    border: 1px solid var(--md-sys-color-outline);
}

/* =====================================================
   M3 SEGMENTED BUTTONS
   ===================================================== */

.md-segmented-buttons {
    display: inline-flex;
    border: 1px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-corner-full);
    overflow: hidden;
}

.md-segmented-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 16px;
    border: none;
    background: transparent;
    color: var(--md-sys-color-on-surface);
    font-size: var(--md-sys-typescale-label-large-size);
    font-weight: var(--md-sys-typescale-label-large-weight);
    cursor: pointer;
    transition: all var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard);
    border-right: 1px solid var(--md-sys-color-outline);
}

.md-segmented-button:last-child {
    border-right: none;
}

.md-segmented-button:hover {
    background: var(--md-sys-color-surface-container-highest);
}

.md-segmented-button.selected {
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
}

/* =====================================================
   M3 BOTTOM SHEET
   ===================================================== */

.md-bottom-sheet-overlay {
    position: fixed;
    inset: 0;
    background: var(--md-sys-color-scrim);
    opacity: 0.32;
    z-index: 999;
}

.md-bottom-sheet {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--md-sys-color-surface-container-low);
    border-radius: var(--md-sys-shape-corner-extra-large) var(--md-sys-shape-corner-extra-large) 0 0;
    padding: 24px;
    z-index: 1000;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: var(--md-sys-elevation-level1);
    animation: md-sheet-slide-up var(--md-sys-motion-duration-medium2) var(--md-sys-motion-easing-emphasized-decelerate);
}

@keyframes md-sheet-slide-up {
    from {
        transform: translateY(100%);
    }

    to {
        transform: translateY(0);
    }
}

.md-bottom-sheet-handle {
    width: 32px;
    height: 4px;
    background: var(--md-sys-color-on-surface-variant);
    border-radius: var(--md-sys-shape-corner-full);
    margin: 0 auto 16px;
    opacity: 0.4;
}

/* =====================================================
   M3 MENU
   ===================================================== */

.md-menu {
    background: var(--md-sys-color-surface-container);
    border-radius: var(--md-sys-shape-corner-extra-small);
    padding: 8px 0;
    box-shadow: var(--md-sys-elevation-level2);
    min-width: 112px;
    max-width: 280px;
}

.md-menu-item {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 48px;
    padding: 0 12px;
    cursor: pointer;
    font-size: var(--md-sys-typescale-body-large-size);
    color: var(--md-sys-color-on-surface);
    transition: background var(--md-sys-motion-duration-short2);
}

.md-menu-item:hover {
    background: var(--md-sys-color-surface-container-highest);
}

.md-menu-item-leading {
    font-size: 24px;
    color: var(--md-sys-color-on-surface-variant);
}

.md-menu-divider {
    height: 1px;
    background: var(--md-sys-color-outline-variant);
    margin: 8px 0;
}

/* =====================================================
   M3 UTILITIES - ADDITIONAL
   ===================================================== */

/* 1. Enhanced Ripple Effect (WOW Effect) */
/* Creates a centered radial ripple that expands on release */
.md-ripple {
    position: relative;
    overflow: hidden;
    transform: translate3d(0, 0, 0);
    /* Hardware acceleration */
}

.md-ripple::after {
    content: "";
    display: block;
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    pointer-events: none;
    background-image: radial-gradient(circle, currentColor 10%, transparent 10.01%);
    background-repeat: no-repeat;
    background-position: 50%;
    transform: scale(10, 10);
    opacity: 0;
    transition: transform 0.5s, opacity 1s;
}

.md-ripple:active::after {
    transform: scale(0, 0);
    opacity: 0.12;
    transition: 0s;
}

/* 2. Enhanced Focus Ring (WOW Effect) */
/* Animated offset for better visibility and feel */
.md-focus-ring {
    transition: outline-offset 0.2s cubic-bezier(0.2, 0, 0, 1), outline-color 0.2s linear;
}

.md-focus-ring:focus-visible {
    outline: 2px solid var(--md-sys-color-primary);
    outline-offset: 4px;
    border-radius: inherit;
    /* Adapts to button/input shape */
}

/* 3. Skeleton Loader (WOW Effect) */
/* Shimmering loading state for better perceived performance */
@keyframes md-shimmer {
    0% {
        transform: translateX(-100%);
    }

    100% {
        transform: translateX(100%);
    }
}

.md-skeleton {
    position: relative;
    overflow: hidden;
    background-color: var(--md-sys-color-surface-container-highest);
    border-radius: var(--md-sys-shape-corner-small);
    /* Remove existing content styles if applied to real elements */
    color: transparent !important;
    border-color: transparent !important;
    user-select: none;
    pointer-events: none;
}

.md-skeleton::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    background: linear-gradient(90deg,
            transparent 0%,
            rgba(255, 255, 255, 0.5) 50%,
            transparent 100%);
    transform: translateX(-100%);
    animation: md-shimmer 1.5s infinite;
}

/* Dark mode adjustment for skeleton shimmer */
[data-theme="dark"] .md-skeleton::after {
    background: linear-gradient(90deg,
            transparent 0%,
            rgba(255, 255, 255, 0.1) 50%,
            transparent 100%);
}

/* Skeleton Utilities */
.md-skeleton-text {
    height: 16px;
    width: 100%;
    margin-bottom: 8px;
    border-radius: 4px;
}

.md-skeleton-circle {
    width: 48px;
    height: 48px;
    border-radius: 50%;
}

.md-skeleton-rect {
    width: 100%;
    height: 200px;
    border-radius: var(--md-sys-shape-corner-medium);
}

/* Disabled State */
.md-disabled,
[disabled] {
    opacity: 0.38;
    pointer-events: none;
    box-shadow: none !important;
}

/* Touch Target */
.md-touch-target {
    position: relative;
}

.md-touch-target::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    min-width: 48px;
    min-height: 48px;
}

/* =====================================================
   ÁNH DƯƠNG LOGO BADGE - M3 Shared Component
   Premium logo badge styling with M3 design tokens
   ===================================================== */

.ad-logo-badge {
    position: relative;
    width: 56px;
    height: 56px;
    border-radius: var(--md-sys-shape-corner-medium);
    background: linear-gradient(145deg, #ffffff 0%, var(--md-sys-color-primary-container) 100%);
    padding: 2px;
    border: 2px solid var(--md-sys-color-primary);
    box-shadow:
        0 0 0 2px rgba(168, 240, 160, 0.4),
        var(--md-sys-elevation-level2),
        0 0 20px rgba(168, 240, 160, 0.3);
    transition: all var(--md-sys-motion-duration-medium2) var(--md-sys-motion-easing-emphasized);
    overflow: hidden;
    flex-shrink: 0;
}

.ad-logo-badge::before {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: var(--md-sys-shape-corner-large);
    background: radial-gradient(circle, rgba(168, 240, 160, 0.3) 0%, transparent 70%);
    pointer-events: none;
    opacity: 0.6;
}

.ad-logo-badge img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: calc(var(--md-sys-shape-corner-medium) - 2px);
    image-rendering: -webkit-optimize-contrast;
}

/* Size variants */
.ad-logo-badge--small {
    width: 40px;
    height: 40px;
    border-radius: var(--md-sys-shape-corner-small);
}

.ad-logo-badge--large {
    width: 64px;
    height: 64px;
    border-radius: var(--md-sys-shape-corner-large);
}

.ad-logo-badge--xlarge {
    width: 80px;
    height: 80px;
    border-radius: var(--md-sys-shape-corner-extra-large);
}

/* Hover effect */
.ad-logo-badge:hover,
a:hover .ad-logo-badge,
button:hover .ad-logo-badge {
    transform: scale(1.08) translateY(-2px);
    border-color: var(--md-ref-palette-primary50);
    box-shadow:
        0 0 0 3px rgba(168, 240, 160, 0.6),
