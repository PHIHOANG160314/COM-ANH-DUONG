{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "trailingSlash": false,
    "rewrites": [
        {
            "source": "/",
            "destination": "/index.html"
        },
        {
            "source": "/customer",
            "destination": "/customer.html"
        },
        {
            "source": "/customer/",
            "destination": "/customer.html"
        },
        {
            "source": "/staff",
            "destination": "/staff-mobile.html"
        },
        {
            "source": "/staff/",
            "destination": "/staff-mobile.html"
        },
        {
            "source": "/admin",
            "destination": "/index.html"
        },
        {
            "source": "/admin/",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "X-XSS-Protection",
                    "value": "1; mode=block"
                }
            ]
        },
        {
            "source": "/sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                },
                {
                    "key": "Service-Worker-Allowed",
                    "value": "/"
                }
            ]
        }
    ]
}