# Supabase Configuration
# The URL of your Supabase project (e.g. https://xyz.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# The anonymous public key for your Supabase project
# This key is safe to use in the browser
VITE_SUPABASE_ANON_KEY=your-anon-key

# Application Configuration
# The name of the application displayed in the UI
VITE_APP_NAME="Cơm Ánh Dương"

# Optional: Enable analytics (true/false)
VITE_ENABLE_ANALYTICS=false
