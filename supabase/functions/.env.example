# Payment Gateway Secrets Template
# Run the following commands to set secrets in Supabase
# Replace "your_value_here" with actual sandbox credentials

# VNPay Sandbox
supabase secrets set VNP_TMN_CODE="your_tmn_code_here"
supabase secrets set VNP_HASH_SECRET="your_hash_secret_here"
supabase secrets set VNP_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
supabase secrets set VNP_RETURN_URL="http://localhost:5173/checkout/result"

# MoMo Sandbox
supabase secrets set MOMO_PARTNER_CODE="your_partner_code_here"
supabase secrets set MOMO_ACCESS_KEY="your_access_key_here"
supabase secrets set MOMO_SECRET_KEY="your_secret_key_here"
supabase secrets set MOMO_ENDPOINT="https://test-payment.momo.vn/v2/gateway/api/create"
supabase secrets set MOMO_RETURN_URL="http://localhost:5173/checkout/result"

# Supabase Config (Already set usually, but for local dev)
supabase secrets set SUPABASE_URL="your_project_url"
supabase secrets set SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"
