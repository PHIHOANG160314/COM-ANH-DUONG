{
  "version": "1.0",
  "name": "Customer Order Page",
  "description": "Giao diện đặt món cho khách hàng Cơm Ánh Dương",
  "canvas": {
    "width": 1440,
    "height": 900,
    "background": "#0a0a12"
  },
  "designTokens": {
    "colors": {
      "primary": "#4ade80",
      "secondary": "#10b981",
      "accent": "#f59e0b",
      "background": "#0a0a12",
      "surface": "#1a1a2e",
      "text": "#ffffff",
      "textMuted": "#8888a0"
    },
    "typography": {
      "fontFamily": "Inter, Roboto, sans-serif",
      "fontSize": {
        "xs": "12px",
        "sm": "14px",
        "md": "16px",
        "lg": "20px",
        "xl": "24px",
        "2xl": "32px"
      }
    },
    "spacing": {
      "xs": "4px",
      "sm": "8px",
      "md": "16px",
      "lg": "24px",
      "xl": "32px"
    },
    "borderRadius": {
      "sm": "8px",
      "md": "12px",
      "lg": "16px",
      "full": "9999px"
    }
  },
  "components": [
    {
      "id": "header",
      "type": "header",
      "props": {
        "logo": "Ánh Dương",
        "navigation": ["Menu", "Đặt hàng", "Liên hệ"],
        "cart": true
      }
    },
    {
      "id": "hero",
      "type": "hero-section",
      "props": {
        "title": "Cơm Nhà Ánh Dương",
        "subtitle": "Hương vị quê hương - Chất lượng đảm bảo",
        "cta": "Đặt món ngay"
      }
    },
    {
      "id": "categories",
      "type": "category-tabs",
      "props": {
        "items": ["Cơm phần", "Bún phở", "Món chay", "Đồ uống", "Tráng miệng"]
      }
    },
    {
      "id": "menu-grid",
      "type": "product-grid",
      "props": {
        "columns": 3,
        "gap": "16px",
        "showPrice": true,
        "showAddToCart": true
      }
    },
    {
      "id": "cart-sidebar",
      "type": "cart",
      "props": {
        "position": "right",
        "showTotal": true,
        "checkoutButton": "Đặt hàng"
      }
    }
  ],
  "prompts": [
    "Create a modern restaurant ordering page with Vietnamese cuisine theme",
    "Dark mode with green accent colors",
    "Mobile-first responsive design",
    "Include category tabs, food cards with images, and cart summary"
  ]
}
